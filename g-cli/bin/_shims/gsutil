#!/usr/bin/env bash
set -euo pipefail
real="${CLOUD_CLI_REAL_GSUTIL:-}"
if [[ -z "$real" ]]; then
  echo "gcloudt: gsutil not on PATH before --debug (set up PATH or install gcloud gsutil component)" >&2
  exit 127
fi
if [[ -n "${CLOUD_CLI_DEBUG:-}" ]]; then
  printf 'debug:' >&2
  printf ' %q' "$real" "$@" >&2
  printf '\n' >&2
fi
exec "$real" "$@"
