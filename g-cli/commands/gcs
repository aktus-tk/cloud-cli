#!/usr/bin/env bash
set -e

cmd=$1
shift || true

gcs_buckets_csv() {
  echo "Name,Location,StorageClass,CreationTime"
  gcloud storage buckets list --format="csv[no-heading](name,location,storageClass,timeCreated)"
}

gcs_objects_csv() {
  local bucket=$1
  echo "Name,Size,LastModified"
  gsutil ls -lh -r "gs://${bucket}/" 2>/dev/null | grep -v ':$' | grep -v '^TOTAL' | awk -v bucket="${bucket}" '{
    name = $4
    gsub("^gs://" bucket "/", "", name)
    size = $1" "$2
    time = $3
    print name","size","time
  }'
}

gcs_cp() {
  local src=$1
  local dst=$2

  if [[ -z "$src" ]] || [[ -z "$dst" ]]; then
    echo "usage: gcloudt gcs cp <source> <destination>" >&2
    echo "  gcloudt gcs cp gs://BUCKET/OBJECT LOCAL_PATH     # pull (GCS → local)" >&2
    echo "  gcloudt gcs cp LOCAL_PATH gs://BUCKET/OBJECT     # put (local → GCS)" >&2
    exit 1
  fi

  # GCS パスかローカルパスかを判定
  if [[ "$src" =~ ^gs:// ]]; then
    # pull: GCS → ローカル
    echo "Pulling: $src → $dst"
    gsutil cp "$src" "$dst"
  elif [[ "$dst" =~ ^gs:// ]]; then
    # put: ローカル → GCS
    echo "Pushing: $src → $dst"
    gsutil cp "$src" "$dst"
  else
    echo "error: either source or destination must be a GCS path (gs://...)" >&2
    exit 1
  fi
}

gcs_rm() {
  local path=$1

  if [[ -z "$path" ]]; then
    echo "usage: gcloudt gcs rm <GCS_PATH>" >&2
    echo "  gcloudt gcs rm gs://BUCKET/OBJECT              # delete single object" >&2
    echo "  gcloudt gcs rm gs://BUCKET/PREFIX/ -r          # delete recursively" >&2
    exit 1
  fi

  if [[ ! "$path" =~ ^gs:// ]]; then
    echo "error: path must be a GCS path (gs://...)" >&2
    exit 1
  fi

  # 再帰オプションをチェック
  if [[ "${2:-}" == "-r" ]] || [[ "${2:-}" == "--recursive" ]]; then
    echo "Deleting recursively: $path"
    gsutil -m rm -r "$path"
  else
    echo "Deleting: $path"
    gsutil rm "$path"
  fi
}

case "$cmd" in
  ls)
    if [[ -z "$1" ]]; then
      # バケット一覧表示
      gcs_buckets_csv | column -t -s ','
    elif [[ "$1" == "--csv" ]]; then
      # バケット一覧（CSV形式）
      gcs_buckets_csv
    else
      # 指定バケット内のオブジェクト一覧表示
      bucket=$1
      format=${2:-"table"}
      if [[ "$format" == "--csv" ]]; then
        gcs_objects_csv "$bucket"
      else
        gcs_objects_csv "$bucket" | column -t -s ','
      fi
    fi
    ;;
  cp)
    gcs_cp "$@"
    ;;
  rm)
    gcs_rm "$@"
    ;;
  help|-h|--help|"")
    echo "gcs (google cloud storage) commands:"
    echo "  ls                                  list buckets (table format)"
    echo "  ls --csv                            list buckets (CSV format)"
    echo "  ls BUCKET_NAME                      list objects in bucket (table format)"
    echo "  ls BUCKET_NAME --csv                list objects in bucket (CSV format)"
    echo "  cp SRC DEST                         copy objects (pull or push)"
    echo "    Example:"
    echo "      gcloudt gcs cp gs://BUCKET/OBJECT LOCAL_PATH     # pull"
    echo "      gcloudt gcs cp LOCAL_PATH gs://BUCKET/OBJECT     # push"
    echo "  rm GCS_PATH [OPTIONS]               delete objects"
    echo "    Example:"
    echo "      gcloudt gcs rm gs://BUCKET/OBJECT                # delete single object"
    echo "      gcloudt gcs rm gs://BUCKET/PREFIX/ -r            # delete recursively"
    ;;
  *)
    echo "unknown command: $cmd" >&2
    echo "run: gcloudt gcs help" >&2
    exit 1
    ;;
esac
