#!/usr/bin/env bash
set -e

cmd=$1
shift

# forwarding-rules と関連リソースを取得してツリー表示
clb_info() {
  local name=$1
  if [[ -z "$name" ]]; then
    echo "usage: gcloudt clb info [NAME]"
    exit 1
  fi

  # forwarding-rule の情報取得（global/regional 両方試す）
  local fr_info
  fr_info=$(gcloud compute forwarding-rules describe "$name" --global --format=json 2>/dev/null) || \
  fr_info=$(gcloud compute forwarding-rules describe "$name" --region=asia-northeast1 --format=json 2>/dev/null) || {
    echo "Forwarding rule '$name' not found"
    exit 1
  }

  local ip_address=$(echo "$fr_info" | jq -r '.IPAddress // empty')
  local port_range=$(echo "$fr_info" | jq -r '.portRange // empty')
  local target=$(echo "$fr_info" | jq -r '.target // empty')
  local lb_scheme=$(echo "$fr_info" | jq -r '.loadBalancingScheme // "EXTERNAL"')

  echo "Load Balancer: $name"
  echo "├─ IP Address: $ip_address"
  echo "├─ Port Range: $port_range"
  echo "├─ Scheme: $lb_scheme"
  echo "└─ Target Chain:"

  if [[ -z "$target" ]]; then
    echo "   └─ (no target)"
    return
  fi

  # target の種類を判別（target-http-proxy, target-https-proxy など）
  local target_name=$(basename "$target")
  local target_type=""

  if [[ "$target" == *"targetHttpProxies"* ]]; then
    target_type="target-http-proxies"
  elif [[ "$target" == *"targetHttpsProxies"* ]]; then
    target_type="target-https-proxies"
  elif [[ "$target" == *"targetSslProxies"* ]]; then
    target_type="target-ssl-proxies"
  elif [[ "$target" == *"targetTcpProxies"* ]]; then
    target_type="target-tcp-proxies"
  else
    echo "   └─ $target (unknown type)"
    return
  fi

  echo "   ├─ Target Proxy: $target_name ($target_type)"

  # プロキシの情報取得
  local proxy_info
  if [[ "$target_type" == "target-http-proxies" ]]; then
    proxy_info=$(gcloud compute target-http-proxies describe "$target_name" --global --format=json 2>/dev/null || echo "{}")
  elif [[ "$target_type" == "target-https-proxies" ]]; then
    proxy_info=$(gcloud compute target-https-proxies describe "$target_name" --global --format=json 2>/dev/null || echo "{}")
  elif [[ "$target_type" == "target-ssl-proxies" ]]; then
    proxy_info=$(gcloud compute target-ssl-proxies describe "$target_name" --global --format=json 2>/dev/null || echo "{}")
  elif [[ "$target_type" == "target-tcp-proxies" ]]; then
    proxy_info=$(gcloud compute target-tcp-proxies describe "$target_name" --global --format=json 2>/dev/null || echo "{}")
  fi

  local url_map=$(echo "$proxy_info" | jq -r '.urlMap // .service // empty')

  if [[ -z "$url_map" ]]; then
    echo "   └─ (no url-map or backend-service)"
    return
  fi

  local url_map_name=$(basename "$url_map")

  # URL Map がある場合（HTTP/HTTPS LB）
  if [[ "$url_map" == *"urlMaps"* ]]; then
    echo "   │  └─ URL Map: $url_map_name"

    # URL Map の情報取得
    local urlmap_info=$(gcloud compute url-maps describe "$url_map_name" --global --format=json 2>/dev/null || echo "{}")
    local default_service=$(echo "$urlmap_info" | jq -r '.defaultService // empty')

    if [[ -n "$default_service" ]]; then
      local backend_name=$(basename "$default_service")
      echo "   │     └─ Default Backend Service: $backend_name"

      # バックエンドサービスの詳細取得
      show_backend_service "$backend_name" "   │        "
    fi
  else
    # 直接 backend-service を参照している場合（SSL/TCP LB）
    local backend_name=$(basename "$url_map")
    echo "   │  └─ Backend Service: $backend_name"
    show_backend_service "$backend_name" "   │     "
  fi
}

# バックエンドサービスとその配下を表示
show_backend_service() {
  local backend_name=$1
  local indent=$2

  local backend_info=$(gcloud compute backend-services describe "$backend_name" --global --format=json 2>/dev/null || \
                       gcloud compute backend-services describe "$backend_name" --region=asia-northeast1 --format=json 2>/dev/null || \
                       echo "{}")

  local protocol=$(echo "$backend_info" | jq -r '.protocol // empty')
  local backends=$(echo "$backend_info" | jq -c '.backends[]? // empty')

  if [[ -n "$protocol" ]]; then
    echo "${indent}Protocol: $protocol"
  fi

  if [[ -z "$backends" ]]; then
    echo "${indent}└─ (no backends)"
    return
  fi

  echo "${indent}Backends:"
  echo "$backends" | while IFS= read -r backend; do
    local group=$(echo "$backend" | jq -r '.group // empty')
    local balancing_mode=$(echo "$backend" | jq -r '.balancingMode // empty')

    if [[ -n "$group" ]]; then
      local group_name=$(basename "$group")
      echo "${indent}└─ Instance Group: $group_name"
      echo "${indent}   └─ Balancing Mode: $balancing_mode"
    fi
  done
}

# forwarding-rules の一覧表示
clb_ls() {
  echo "NAME,IP,PORT,TARGET_TYPE,URL_MAP,SCHEME"

  # Global forwarding rules
  gcloud compute forwarding-rules list --global --format=json 2>/dev/null | \
  jq -r '.[] | [.name, .IPAddress, .portRange, (.target | split("/")[-2]), "", .loadBalancingScheme] | @csv' | \
  while IFS=',' read -r name ip port target_type _ scheme; do
    # クォート除去
    name=${name//\"/}; ip=${ip//\"/}; port=${port//\"/}; target_type=${target_type//\"/}; scheme=${scheme//\"/}

    # target-proxy から url-map を取得
    local url_map=""
    if [[ "$target_type" == "targetHttpProxies" ]]; then
      local proxy_name=$(gcloud compute forwarding-rules describe "$name" --global --format="value(target.basename())")
      url_map=$(gcloud compute target-http-proxies describe "$proxy_name" --global --format="value(urlMap.basename())" 2>/dev/null || echo "")
    elif [[ "$target_type" == "targetHttpsProxies" ]]; then
      local proxy_name=$(gcloud compute forwarding-rules describe "$name" --global --format="value(target.basename())")
      url_map=$(gcloud compute target-https-proxies describe "$proxy_name" --global --format="value(urlMap.basename())" 2>/dev/null || echo "")
    fi

    echo "$name,$ip,$port,$target_type,$url_map,$scheme"
  done

  # Regional forwarding rules（必要に応じてリージョンを追加）
  gcloud compute forwarding-rules list --filter="region:asia-northeast1" --format=json 2>/dev/null | \
  jq -r '.[] | [.name, .IPAddress, .portRange, (.target | split("/")[-2]), "", .loadBalancingScheme] | @csv' | \
  while IFS=',' read -r name ip port target_type _ scheme; do
    name=${name//\"/}; ip=${ip//\"/}; port=${port//\"/}; target_type=${target_type//\"/}; scheme=${scheme//\"/}
    echo "$name,$ip,$port,$target_type,,$scheme"
  done
}

# IP アドレスのみ表示
clb_ip() {
  echo "NAME,IP_ADDRESS"

  # Global
  gcloud compute forwarding-rules list --global --format="csv[no-heading](name,IPAddress)" 2>/dev/null

  # Regional
  gcloud compute forwarding-rules list --filter="region:asia-northeast1" --format="csv[no-heading](name,IPAddress)" 2>/dev/null
}

# Certificate Manager: gcloud certificate-manager maps list
clb_cert_maps() {
  gcloud certificate-manager maps list "$@"
}

# 予約済み Global/Regional IP アドレス一覧
clb_addresses() {
  echo "NAME,ADDRESS,STATUS,REGION,TYPE"
  gcloud compute addresses list --format=json | jq -r '
    .[] |
    [
      .name,
      .address,
      .status,
      (.region // "" | split("/") | .[-1]),
      (.addressType // "EXTERNAL")
    ] | @csv
  '
}

# SSL 証明書 (compute ssl-certificates, 旧方式) 一覧
clb_ssl_certs() {
  gcloud compute ssl-certificates list "$@"
}

# Certificate Manager 証明書一覧
clb_certificates() {
  gcloud certificate-manager certificates list "$@"
}

# Certificate Manager 証明書一覧 (CSV: scope は実効値 DEFAULT を補完)
clb_certificates_csv() {
  gcloud certificate-manager certificates list "$@" --format=json | jq -r '
    "NAME,SCOPE,EXPIRE_TIME,CREATE_TIME",
    (.[] | [
      (.name | split("/") | .[-1]),
      (.scope // "DEFAULT"),
      .expireTime,
      .createTime
    ] | @csv)
  '
}

# Backend Service 一覧
clb_backend_services() {
  gcloud compute backend-services list "$@"
}

# Target Proxy 一覧 (HTTP/HTTPS を TYPE 列で結合)
clb_target_proxies() {
  local http
  local https
  http=$(gcloud compute target-http-proxies list --format=json 2>/dev/null | \
    jq -r '.[] | [.name, "HTTP", (.urlMap | split("/") | .[-1])] | @tsv')
  https=$(gcloud compute target-https-proxies list --format=json 2>/dev/null | \
    jq -r '.[] | [.name, "HTTPS", (.urlMap | split("/") | .[-1]), (.certificateMap // "" | split("/") | .[-1])] | @tsv')
  echo "NAME,TYPE,URL_MAP,CERTIFICATE_MAP"
  # HTTP 行は3フィールド、HTTPS 行は4フィールド。フィールド数に応じて出力し、
  # 存在しない列 (HTTP の CERTIFICATE_MAP) に空フィールドを付けない。
  { printf '%s\n' "$http"; printf '%s\n' "$https"; } | \
    awk -F'\t' 'NF>0 { printf "%s", $1; for (i=2; i<=NF; i++) printf ",%s", $i; print "" }'
}

# SSL 証明書の期限状態を判定（certs / proxy-certs 共通）
# 引数: expireTime (ISO8601, 例: 2026-08-31T07:59:59.000-07:00)
# 返り値: OK (有効期限内) / EXPIRING (30日以内) / EXPIRED (期限切れ)
cert_status() {
  local expire=$1
  local expire_epoch now_epoch
  if [[ -z "$expire" ]]; then
    echo "OK"
    return
  fi
  if ! expire_epoch=$(date -d "$expire" +%s 2>/dev/null); then
    echo "UNKNOWN"
    return
  fi
  now_epoch=$(date +%s)
  if (( expire_epoch <= now_epoch )); then
    echo "EXPIRED"
  elif (( expire_epoch - now_epoch <= 2592000 )); then  # 30日 = 2592000秒
    echo "EXPIRING"
  else
    echo "OK"
  fi
}

# gcloud を実行し、失敗 (exit != 0 または stderr にエラー/警告) を検出したら stderr にエラーを出して return 1
# 正常時は gcloud の stdout をそのまま呼び出し元へ渡す
# 注: gcloud list はプロジェクト名誤り等でも exit 0 + stderr 警告 ("Some requests did not succeed") を返すため、
#     exit status だけでは「証明書ゼロ」と区別できない。stderr も検査する。
gcloud_checked() {
  local err_file rc msg
  err_file=$(mktemp)
  "$@" 2>"$err_file"
  rc=$?
  if (( rc != 0 )) || [[ -s "$err_file" ]]; then
    msg=$(tr '\n' ' ' < "$err_file")
    echo "clb: gcloud command failed: $*${msg:+ ($msg)}" >&2
    rm -f "$err_file"
    return 1
  fi
  rm -f "$err_file"
}

# SSL 証明書一覧（状態付き）
clb_certs() {
  local json
  json=$(gcloud_checked gcloud compute ssl-certificates list --format=json) || exit 1

  echo "NAME,TYPE,CREATE_TIME,EXPIRE_TIME,SAN,STATUS"

  echo "$json" | \
  jq -r '.[] | [.name, .type, .creationTimestamp, .expireTime, (.subjectAlternativeNames | join("; "))] | @csv' | \
  while IFS=',' read -r name cert_type create expire san; do
    # クォート除去
    name=${name//\"/}; cert_type=${cert_type//\"/}; create=${create//\"/}; expire=${expire//\"/}; san=${san//\"/}
    local status
    status=$(cert_status "$expire")
    echo "$name,$cert_type,$create,$expire,$san,$status"
  done
}

# target-https-proxies ごとの証明書紐付けと状態
clb_proxy_certs() {
  # 証明書名 → expireTime のマップを構築
  local -A cert_expire=()
  local name expire
  local ssl_list
  ssl_list=$(gcloud_checked gcloud compute ssl-certificates list --format="value(name,expireTime)") || exit 1
  if [[ -n "$ssl_list" ]]; then
    while IFS=$'\t' read -r name expire; do
      cert_expire["$name"]="$expire"
    done <<< "$ssl_list"
  fi

  local proxies_json
  proxies_json=$(gcloud_checked gcloud compute target-https-proxies list --format=json) || exit 1

  echo "PROXY,CERT_NAME,STATUS,EXPIRE_TIME"

  echo "$proxies_json" | \
  jq -r '.[] | .name as $proxy | .sslCertificates[]? | [$proxy, (split("/") | last)] | @csv' | \
  while IFS=',' read -r proxy cert; do
    # クォート除去
    proxy=${proxy//\"/}; cert=${cert//\"/}
    local expire="${cert_expire[$cert]:-}"
    local status
    status=$(cert_status "$expire")
    echo "$proxy,$cert,$status,$expire"
  done
}

case "$cmd" in
  ls)
    if [[ "$1" == "--csv" ]]; then
      clb_ls
    else
      clb_ls | column -t -s ','
    fi
    ;;
  info)
    clb_info "$1"
    ;;
  ip)
    if [[ "$1" == "--csv" ]]; then
      clb_ip
    else
      clb_ip | column -t -s ','
    fi
    ;;
  cert-maps)
    if [[ "$1" == "--csv" ]]; then
      shift
      clb_cert_maps --format="csv(name,createTime)" "$@"
    else
      clb_cert_maps "$@"
    fi
    ;;
  cert-map-entries)
    extra=()
    if [[ "$1" == "--csv" ]]; then
      shift
      extra=(--format="csv(name,hostname,certificates,state)")
    fi
    map=$1
    shift || true
    if [[ -z "$map" ]]; then
      echo "usage: gcloudt clb cert-map-entries [--csv] MAP_NAME [gcloud options...]"
      exit 1
    fi
    gcloud certificate-manager maps entries list --map="$map" "${extra[@]}" "$@"
    ;;
  addresses)
    if [[ "$1" == "--csv" ]]; then
      clb_addresses
    else
      clb_addresses | sed 's/"//g' | column -t -s ','
    fi
    ;;
  ssl-certs)
    if [[ "$1" == "--csv" ]]; then
      shift
      clb_ssl_certs --format="csv(name,type,creationTimestamp,expireTime)" "$@"
    else
      clb_ssl_certs "$@"
    fi
    ;;
  certificates)
    if [[ "$1" == "--csv" ]]; then
      shift
      clb_certificates_csv "$@"
    else
      clb_certificates "$@"
    fi
    ;;
  backend-services)
    if [[ "$1" == "--csv" ]]; then
      shift
      clb_backend_services --format="csv(name,protocol,portName,backends[].group.basename())" "$@"
    else
      clb_backend_services "$@"
    fi
    ;;
  target-proxies)
    if [[ "$1" == "--csv" ]]; then
      clb_target_proxies
    else
      clb_target_proxies | column -t -s ','
    fi
    ;;
  certs)
    if [[ "$1" == "--csv" ]]; then
      clb_certs
    else
      clb_certs | column -t -s ','
      exit "${PIPESTATUS[0]}"
    fi
    ;;
  proxy-certs)
    if [[ "$1" == "--csv" ]]; then
      clb_proxy_certs
    else
      clb_proxy_certs | column -t -s ','
      exit "${PIPESTATUS[0]}"
    fi
    ;;
  help|*)
    echo "clb (Cloud Load Balancer) commands:"
    echo "  ls           list load balancers (forwarding-rules + target-proxy + url-map)"
    echo "  ls --csv     list as CSV"
    echo "  info [NAME]  show detailed tree from IP to backend instances"
    echo "  ip           show IP addresses only"
    echo "  ip --csv     show IP addresses as CSV"
    echo "  addresses [--csv]              reserved Global/Regional IP addresses"
    echo "  ssl-certs [--csv] [opts...]    SSL certificates (compute, legacy)"
    echo "  certificates [--csv] [opts...] Certificate Manager certificates"
    echo "  backend-services [--csv] [opts...]  backend services list"
    echo "  target-proxies [--csv]         HTTP + HTTPS target proxies (combined, TYPE col)"
    echo "  cert-maps [--csv] [gcloud options...]  Certificate Manager maps (gcloud certificate-manager maps list)"
    echo "  cert-map-entries [--csv] MAP [opts...]  map entries (gcloud certificate-manager maps entries list --map=MAP)"
    echo "  certs [--csv]        SSL certificates with status (OK/EXPIRING/EXPIRED)"
    echo "  proxy-certs [--csv]  SSL certs per target-https-proxy with status"
    ;;
esac
