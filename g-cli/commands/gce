#!/usr/bin/env bash
set -e

cmd=$1
shift

gce_ls_csv () {
  declare -A type_map
  declare -A shared_cpu_map=([e2-micro]=0.25 [e2-small]=0.5 [e2-medium]=1.0)

  # マシンタイプ情報の取得
  machine_types=$(gcloud compute instances list --format="value(machineType.basename())" | sort | uniq)
  for mt in $machine_types; do
    if [[ $mt == custom* ]]; then
      vcpu=$(echo $mt | cut -d'-' -f2); mem_gb=$(echo $mt | cut -d'-' -f3)
      type_map["$mt"]="$vcpu,$((mem_gb * 1024))"
    else
      cpumem=($(gcloud compute machine-types describe "$mt" --zone=asia-northeast1-c --format="value(guestCpus,memoryMb)"))
      vcpu=${cpumem[0]}; mem=${cpumem[1]}
      [[ -n "${shared_cpu_map[$mt]}" ]] && vcpu="${shared_cpu_map[$mt]}"
      type_map["$mt"]="${vcpu},${mem}"
    fi
  done

  # ヘッダー出力
  echo '"index","name","status","machine_type","zone","internal_ip","external_ip","vcpu","mem","disks","tags"'

  # ヘルパー関数：インスタンスのディスク情報を取得
  get_disk_info() {
    local name=$1 zone=$2

    gcloud compute instances describe "$name" --zone="$zone" --format="json" | jq -r '.disks[] | "\(.source | split("/") | .[-1]),\(.boot)"' | while IFS=',' read -r disk_name boot; do
      if [[ -n "$disk_name" ]]; then
        disk_detail=$(gcloud compute disks describe "$disk_name" --zone="$zone" --format="value(sizeGb,type.scope())" 2>/dev/null || echo "")
        if [[ -n "$disk_detail" ]]; then
          read -r size dtype <<< "$disk_detail"
          dtype=$(echo "$dtype" | sed 's|.*diskTypes/||')
          if [[ "$boot" == "true" ]]; then
            echo -n "boot:${size}G(${dtype}),"
          else
            echo -n "${disk_name}:${size}G(${dtype}),"
          fi
        fi
      fi
    done | sed 's/,$//'
  }

  index=1
  # gcloudからCSV形式で取得（tags.list()などは自動でクォートされるが、一貫性のため手動で制御）
  gcloud compute instances list --format="csv[no-heading](name,status,machineType.basename(),zone.scope(),networkInterfaces[0].networkIP,networkInterfaces[0].accessConfigs[0].natIP,tags.list())" |
  sort -t',' -k5 -V |
  while IFS=',' read -r name status machine_type zone ip_int ip_ext tags; do

    vcpu_mem="${type_map[$machine_type]}"
    IFS=',' read -r v_val m_val <<< "${vcpu_mem}"

    # ディスク情報の取得
    disk_info=$(get_disk_info "$name" "$zone")

    # すべての項目をダブルクォートで囲む
    clean_tags=$(echo "$tags" | sed 's/^"//;s/"$//')

    printf '"%s","%s","%s","%s","%s","%s","%s","%s","%s","%s","%s"\n' \
      "$index" \
      "$name" \
      "$status" \
      "$machine_type" \
      "$zone" \
      "$ip_int" \
      "${ip_ext:-}" \
      "$v_val" \
      "$m_val" \
      "$disk_info" \
      "$clean_tags"

    ((index++))
  done
}

case "$cmd" in
  ls)
    if [[ "$1" == "--csv" ]]; then
      gce_ls_csv
    else
      gce_ls_csv | sed 's/","/\t/g; s/^"//; s/"$//' | column -t -s $'\t'
    fi
  ;;
  show)
    if [[ -z "$1" ]]; then
      echo "usage: gcloudt gce show INSTANCE_NAME [gcloud describe options...]" >&2
      exit 1
    fi
    gcloud compute instances describe "$@"
  ;;
  images)
  gcloud compute images list --no-standard-images --format="table(name, creationTimestamp, sourceDisk, status, archiveSizeGb)"
  ;;
  templates)
    gcloud compute instance-templates list "$@"
  ;;
  template)
    if [[ -z "$1" ]]; then
      echo "usage: gcloudt gce template INSTANCE_TEMPLATE_NAME [gcloud describe options...]"
      exit 1
    fi
    gcloud compute instance-templates describe "$@"
    ;;
  groups)
  gcloud compute instance-groups list
  ;;
  # インスタンスグループのメンバー一覧 (unmanaged / managed 両対応)
  group-instances)
    grp=$1
    shift || true
    if [[ -z "$grp" ]]; then
      echo "usage: gcloudt gce group-instances GROUP_NAME [--zone=ZONE|--region=REGION] [opts...]" >&2
      exit 1
    fi
    # ゾーン/リージョン指定がなければ instance-groups list で自動判定
    zone=""; region=""
    for a in "$@"; do
      case "$a" in
        --zone=*) zone="${a#--zone=}" ;;
        --region=*) region="${a#--region=}" ;;
      esac
    done
    if [[ -z "$zone" && -z "$region" ]]; then
      # instance-groups list は zonal / regional の両方を返し、zone か region の
      # どちらかが入る。同名が複数ある場合は先頭のみ使用。
      loc="$(gcloud compute instance-groups list --filter="name=$grp" \
        --format="value(zone.basename(),region.basename())" 2>/dev/null | awk 'NR==1 {print}')"
      if [[ -n "$loc" ]]; then
        read -r zone region <<< "$loc"
      fi
      if [[ -z "$zone" && -z "$region" ]]; then
        echo "error: could not resolve zone/region for group '$grp'" >&2
        echo "  (instance-groups list が空・権限エラーの可能性。--zone= または --region= を明示指定してください)" >&2
        exit 1
      fi
    fi
    if [[ -n "$zone" ]]; then
      gcloud compute instance-groups list-instances "$grp" --zone="$zone" "$@"
    else
      gcloud compute instance-groups list-instances "$grp" --region="$region" "$@"
    fi
    ;;
  managed-group)
    mg_cmd=$1
    shift || true
    case "$mg_cmd" in
      describe)
        if [[ -z "$1" ]]; then
          echo "usage: gcloudt gce managed-group describe NAME [gcloud describe options...]" >&2
          exit 1
        fi
        gcloud compute instance-groups managed describe --region=asia-northeast1 "$@"
        ;;
      *)
        gcloud compute instance-groups managed list-instances --region=asia-northeast1 "$mg_cmd" "$@"
        ;;
    esac
    ;;
  #start) aws gce start-instances --instance-ids $(gce_get_id "$1") ;;
  #stop)  aws gce  stop-instances --instance-ids $(gce_get_id "$1") ;;
  *)
    echo "gce commands:"
    echo "  ls         list instances"
    echo "  ls --csv   list instances as csv"
    echo "  show NAME [opts]   instances describe (raw gcloud output)"
    echo "  images     list images"
    echo "  templates  list instance templates"
    echo "  template NAME [opts]   instance-templates describe (raw gcloud output)"
    echo "  groups     instance-groups list"
    echo "  group-instances GROUP [--zone=Z|--region=R] [opts]  list instances in a group (unmanaged/managed auto)"
    echo "  managed-group NAME [opts]        instance-groups managed list-instances"
    echo "  managed-group describe NAME [opts]   instance-groups managed describe"
    echo "  start NAME"
    echo "  stop NAME"
  ;;
esac
