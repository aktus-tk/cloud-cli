#!/usr/bin/env bash
set -e

cmd=$1
shift

gce_ls_csv () {
  declare -A type_map
  declare -A shared_cpu_map=([e2-micro]=0.25 [e2-small]=0.5 [e2-medium]=1.0)

  # マシンタイプ情報の取得
  machine_types=$(gcloud compute instances list --format="value(machineType.basename())" | sort | uniq)
  for mt in $machine_types; do
    if [[ $mt == custom* ]]; then
      vcpu=$(echo $mt | cut -d'-' -f2); mem_gb=$(echo $mt | cut -d'-' -f3)
      type_map["$mt"]="$vcpu,$((mem_gb * 1024))"
    else
      cpumem=($(gcloud compute machine-types describe "$mt" --zone=asia-northeast1-c --format="value(guestCpus,memoryMb)"))
      vcpu=${cpumem[0]}; mem=${cpumem[1]}
      [[ -n "${shared_cpu_map[$mt]}" ]] && vcpu="${shared_cpu_map[$mt]}"
      type_map["$mt"]="${vcpu},${mem}"
    fi
  done

  # ヘッダー出力
  echo '"index","name","status","machine_type","zone","internal_ip","external_ip","vcpu","mem","tags"'

  index=1
  # gcloudからCSV形式で取得（tags.list()などは自動でクォートされるが、一貫性のため手動で制御）
  gcloud compute instances list --format="csv[no-heading](name,status,machineType.basename(),zone.scope(),networkInterfaces[0].networkIP,networkInterfaces[0].accessConfigs[0].natIP,tags.list())" |
  sort -t',' -k5 -V |
  while IFS=',' read -r name status machine_type zone ip_int ip_ext tags; do

    vcpu_mem="${type_map[$machine_type]}"
    IFS=',' read -r v_val m_val <<< "${vcpu_mem}"

    # すべての項目をダブルクォートで囲む
    # tagsはgcloud側ですでにクォートされている可能性があるため、
    # 二重クォートにならないよう、一旦生データとして扱い、ここで改めて囲む
    clean_tags=$(echo "$tags" | sed 's/^"//;s/"$//')

    printf '"%s","%s","%s","%s","%s","%s","%s","%s","%s","%s"\n' \
      "$index" \
      "$name" \
      "$status" \
      "$machine_type" \
      "$zone" \
      "$ip_int" \
      "${ip_ext:-}" \
      "$v_val" \
      "$m_val" \
      "$clean_tags"

    ((index++))
  done
}

case "$cmd" in
  ls)
    if [[ "$1" == "--csv" ]]; then
      gce_ls_csv
    else
      gce_ls_csv | sed 's/","/\t/g; s/^"//; s/"$//' | column -t -s $'\t'
    fi
  ;;
  show)
    if [[ -z "$1" ]]; then
      echo "usage: gcloudt gce show INSTANCE_NAME [gcloud describe options...]" >&2
      exit 1
    fi
    gcloud compute instances describe "$@"
  ;;
  images)
  gcloud compute images list --no-standard-images --format="table(name, creationTimestamp, sourceDisk, status, archiveSizeGb)"
  ;;
  types)
    gcloud compute images list \
      --filter="name ~ rocky-linux" \
      --format="table(name,family,architecture,status,creationTimestamp)"
  ;;
  templates)
    gcloud compute instance-templates list "$@"
  ;;
  template)
    if [[ -z "$1" ]]; then
      echo "usage: gcloudt gce template INSTANCE_TEMPLATE_NAME [gcloud describe options...]"
      exit 1
    fi
    gcloud compute instance-templates describe "$@"
    ;;
  groups)
    g_cmd="${1:-}"
    shift || true
    case "$g_cmd" in
      ""|ls|list)
        gcloud compute instance-groups list "$@"
        ;;
      help|--help|-h)
        echo "groups commands:"
        echo "  groups                         list instance groups"
        echo "  groups describe NAME           describe instance group"
        echo "  groups list-instances NAME     list instances in group"
        ;;
      describe|show)
        if [[ -z "${1:-}" ]]; then
          echo "usage: gcloudt gce groups describe NAME [--zone ZONE|--region REGION]" >&2
          exit 1
        fi
        name="$1"
        shift || true
        if [[ " $* " == *" --zone "* || " $* " == *" --region "* ]]; then
          gcloud compute instance-groups describe "$name" "$@"
        else
          # resolve zone/region from list
          loc_line="$(gcloud compute instance-groups list --filter="name=$name" \
            --format="csv[no-heading](location,locationScope)" | head -1)"
          if [[ -z "$loc_line" ]]; then
            echo "instance group not found: $name" >&2
            exit 1
          fi
          IFS=',' read -r location scope <<< "$loc_line"
          if [[ "$scope" == "REGION" || "$scope" == "region" ]]; then
            gcloud compute instance-groups describe "$name" --region="$location" "$@"
          else
            gcloud compute instance-groups describe "$name" --zone="$location" "$@"
          fi
        fi
        ;;
      list-instances|instances)
        if [[ -z "${1:-}" ]]; then
          echo "usage: gcloudt gce groups list-instances NAME [--zone ZONE|--region REGION]" >&2
          exit 1
        fi
        name="$1"
        shift || true
        if [[ " $* " == *" --zone "* || " $* " == *" --region "* ]]; then
          gcloud compute instance-groups list-instances "$name" "$@"
        else
          loc_line="$(gcloud compute instance-groups list --filter="name=$name" \
            --format="csv[no-heading](location,locationScope)" | head -1)"
          if [[ -z "$loc_line" ]]; then
            echo "instance group not found: $name" >&2
            exit 1
          fi
          IFS=',' read -r location scope <<< "$loc_line"
          if [[ "$scope" == "REGION" || "$scope" == "region" ]]; then
            gcloud compute instance-groups list-instances "$name" --region="$location" "$@"
          else
            gcloud compute instance-groups list-instances "$name" --zone="$location" "$@"
          fi
        fi
        ;;
      *)
        echo "groups commands:"
        echo "  groups                         list instance groups"
        echo "  groups describe NAME           describe instance group"
        echo "  groups list-instances NAME     list instances in group"
        ;;
    esac
    ;;
  managed-group)
    mg_cmd=$1
    shift || true
    case "$mg_cmd" in
      describe)
        if [[ -z "$1" ]]; then
          echo "usage: gcloudt gce managed-group describe NAME [gcloud describe options...]" >&2
          exit 1
        fi
        gcloud compute instance-groups managed describe --region=asia-northeast1 "$@"
        ;;
      *)
        gcloud compute instance-groups managed list-instances --region=asia-northeast1 "$mg_cmd" "$@"
        ;;
    esac
    ;;
  #start) aws gce start-instances --instance-ids $(gce_get_id "$1") ;;
  #stop)  aws gce  stop-instances --instance-ids $(gce_get_id "$1") ;;
  *)
    echo "gce commands:"
    echo "  ls         list instances"
    echo "  ls --csv   list instances as csv"
    echo "  show NAME [opts]   instances describe (raw gcloud output)"
    echo "  images     list images"
    echo "  types      list Rocky Linux images (name ~ rocky-linux)"
    echo "  templates  list instance templates"
    echo "  template NAME [opts]   instance-templates describe (raw gcloud output)"
    echo "  groups                         list instance groups"
    echo "  groups describe NAME           instance-groups describe"
    echo "  groups list-instances NAME     list instances in group"
    echo "  managed-group NAME [opts]        instance-groups managed list-instances"
    echo "  managed-group describe NAME [opts]   instance-groups managed describe"
    echo "  start NAME"
    echo "  stop NAME"
  ;;
esac
