#!/usr/bin/env bash
set -e

cmd=$1
shift

gce_ls_csv () {
  declare -A type_map
  declare -A shared_cpu_map=([e2-micro]=0.25 [e2-small]=0.5 [e2-medium]=1.0)

  # マシンタイプ情報の取得
  machine_types=$(gcloud compute instances list --format="value(machineType.basename())" | sort | uniq)
  for mt in $machine_types; do
    if [[ $mt == custom* ]]; then
      vcpu=$(echo $mt | cut -d'-' -f2); mem_gb=$(echo $mt | cut -d'-' -f3)
      type_map["$mt"]="$vcpu,$((mem_gb * 1024))"
    else
      cpumem=($(gcloud compute machine-types describe "$mt" --zone=asia-northeast1-c --format="value(guestCpus,memoryMb)"))
      vcpu=${cpumem[0]}; mem=${cpumem[1]}
      [[ -n "${shared_cpu_map[$mt]}" ]] && vcpu="${shared_cpu_map[$mt]}"
      type_map["$mt"]="${vcpu},${mem}"
    fi
  done

  # ヘッダー出力
  echo '"index","name","status","machine_type","zone","internal_ip","external_ip","vcpu","mem","tags"'

  index=1
  # gcloudからCSV形式で取得（tags.list()などは自動でクォートされるが、一貫性のため手動で制御）
  gcloud compute instances list --format="csv[no-heading](name,status,machineType.basename(),zone.scope(),networkInterfaces[0].networkIP,networkInterfaces[0].accessConfigs[0].natIP,tags.list())" |
  sort -t',' -k5 -V |
  while IFS=',' read -r name status machine_type zone ip_int ip_ext tags; do

    vcpu_mem="${type_map[$machine_type]}"
    IFS=',' read -r v_val m_val <<< "${vcpu_mem}"

    # すべての項目をダブルクォートで囲む
    # tagsはgcloud側ですでにクォートされている可能性があるため、
    # 二重クォートにならないよう、一旦生データとして扱い、ここで改めて囲む
    clean_tags=$(echo "$tags" | sed 's/^"//;s/"$//')

    printf '"%s","%s","%s","%s","%s","%s","%s","%s","%s","%s"\n' \
      "$index" \
      "$name" \
      "$status" \
      "$machine_type" \
      "$zone" \
      "$ip_int" \
      "${ip_ext:-}" \
      "$v_val" \
      "$m_val" \
      "$clean_tags"

    ((index++))
  done
}

case "$cmd" in
  ls)
    if [[ "$1" == "--csv" ]]; then
      gce_ls_csv
    else
      gce_ls_csv | sed 's/","/\t/g; s/^"//; s/"$//' | column -t -s $'\t'
    fi
  ;;
  show)
    if [[ -z "$1" ]]; then
      echo "usage: gcloudt gce show INSTANCE_NAME [gcloud describe options...]" >&2
      exit 1
    fi
    gcloud compute instances describe "$@"
  ;;
  images)
  gcloud compute images list --no-standard-images --format="table(name, creationTimestamp, sourceDisk, status, archiveSizeGb)"
  ;;
  types)
    gcloud compute images list \
      --filter="name ~ rocky-linux" \
      --format="table(name,family,architecture,status,creationTimestamp)"
  ;;
  templates)
    gcloud compute instance-templates list "$@"
  ;;
  template)
    if [[ -z "$1" ]]; then
      echo "usage: gcloudt gce template INSTANCE_TEMPLATE_NAME [gcloud describe options...]"
      exit 1
    fi
    gcloud compute instance-templates describe "$@"
    ;;
  groups)
    # Resolve spec → name, scope(zone|region), location. Prefer IG name; else backend-service.
    groups_resolve() {
      local spec="$1"
      local name location scope managed
      local row

      row="$(gcloud compute instance-groups list --filter="name=$spec" \
        --format='value(name,location,location_scope,isManaged)' 2>/dev/null | head -1 || true)"
      if [[ -z "$row" ]]; then
        row="$(gcloud compute instance-groups list --filter="name=$spec" \
          --format='value(name,location,locationScope,isManaged)' 2>/dev/null | head -1 || true)"
      fi

      if [[ -n "$row" ]]; then
        IFS=$'\t' read -r name location scope managed <<< "$row"
        name="${name:-$spec}"
        location="$(basename "${location:-}")"
        scope="$(echo "${scope:-zone}" | tr '[:upper:]' '[:lower:]')"
        managed="$(echo "${managed:-No}" | tr '[:upper:]' '[:lower:]')"
        printf '%s\t%s\t%s\t%s\n' "$name" "$scope" "$location" "$managed"
        return 0
      fi

      local bs_json=""
      bs_json="$(gcloud compute backend-services describe "$spec" --global --format=json 2>/dev/null)" || \
      bs_json="$(gcloud compute backend-services describe "$spec" --region=asia-northeast1 --format=json 2>/dev/null)" || true
      [[ -n "$bs_json" ]] || return 1

      local group_url
      group_url="$(echo "$bs_json" | jq -r '(.backends // [])[0].group // empty')"
      [[ -n "$group_url" ]] || {
        echo "backend service has no backends: $spec" >&2
        return 1
      }

      name="$(basename "$group_url")"
      if [[ "$group_url" =~ /zones/([^/]+)/ ]]; then
        scope="zone"
        location="${BASH_REMATCH[1]}"
      elif [[ "$group_url" =~ /regions/([^/]+)/ ]]; then
        scope="region"
        location="${BASH_REMATCH[1]}"
      else
        echo "could not parse instance group URL: $group_url" >&2
        return 1
      fi
      echo "resolved backend-service '$spec' → instance-group '$name' ($scope/$location)" >&2

      # re-check managed flag
      managed="$(gcloud compute instance-groups list --filter="name=$name" \
        --format='value(isManaged)' 2>/dev/null | head -1 || true)"
      managed="$(echo "${managed:-No}" | tr '[:upper:]' '[:lower:]')"
      printf '%s\t%s\t%s\t%s\n' "$name" "$scope" "$location" "$managed"
    }

    groups_describe_resolved() {
      local spec="$1"
      shift || true
      local name scope location managed

      if [[ " $* " == *" --zone "* || " $* " == *" --region "* ]]; then
        if gcloud compute instance-groups unmanaged describe "$spec" "$@" 2>/dev/null; then
          return 0
        fi
        gcloud compute instance-groups managed describe "$spec" "$@"
        return
      fi

      IFS=$'\t' read -r name scope location managed < <(groups_resolve "$spec") || {
        echo "instance group (or backend-service) not found: $spec" >&2
        echo "hint: gcloudt gce groups" >&2
        exit 1
      }
      if [[ -z "$name" || -z "$location" ]]; then
        echo "instance group (or backend-service) not found: $spec" >&2
        exit 1
      fi

      if [[ "$managed" == "yes" || "$managed" == "true" ]]; then
        if [[ "$scope" == "region" ]]; then
          gcloud compute instance-groups managed describe "$name" --region="$location" "$@"
        else
          gcloud compute instance-groups managed describe "$name" --zone="$location" "$@"
        fi
      else
        # unmanaged IGs are zonal
        gcloud compute instance-groups unmanaged describe "$name" --zone="$location" "$@"
      fi
    }

    groups_list_instances_resolved() {
      local spec="$1"
      shift || true
      local name scope location managed

      if [[ " $* " == *" --zone "* || " $* " == *" --region "* ]]; then
        if gcloud compute instance-groups unmanaged list-instances "$spec" "$@" 2>/dev/null; then
          return 0
        fi
        gcloud compute instance-groups managed list-instances "$spec" "$@"
        return
      fi

      IFS=$'\t' read -r name scope location managed < <(groups_resolve "$spec") || {
        echo "instance group (or backend-service) not found: $spec" >&2
        exit 1
      }
      if [[ -z "$name" || -z "$location" ]]; then
        echo "instance group (or backend-service) not found: $spec" >&2
        exit 1
      fi

      if [[ "$managed" == "yes" || "$managed" == "true" ]]; then
        if [[ "$scope" == "region" ]]; then
          gcloud compute instance-groups managed list-instances "$name" --region="$location" "$@"
        else
          gcloud compute instance-groups managed list-instances "$name" --zone="$location" "$@"
        fi
      else
        gcloud compute instance-groups unmanaged list-instances "$name" --zone="$location" "$@"
      fi
    }

    g_cmd="${1:-}"
    shift || true
    case "$g_cmd" in
      ""|ls|list)
        gcloud compute instance-groups list "$@"
        ;;
      help|--help|-h)
        echo "groups commands:"
        echo "  groups                         list instance groups"
        echo "  groups describe NAME           describe IG (NAME may be backend-service)"
        echo "  groups list-instances NAME     list instances in group"
        ;;
      describe|show)
        if [[ -z "${1:-}" ]]; then
          echo "usage: gcloudt gce groups describe NAME [--zone ZONE|--region REGION]" >&2
          exit 1
        fi
        groups_describe_resolved "$@"
        ;;
      list-instances|instances)
        if [[ -z "${1:-}" ]]; then
          echo "usage: gcloudt gce groups list-instances NAME [--zone ZONE|--region REGION]" >&2
          exit 1
        fi
        groups_list_instances_resolved "$@"
        ;;
      *)
        echo "groups commands:"
        echo "  groups                         list instance groups"
        echo "  groups describe NAME           describe IG (NAME may be backend-service)"
        echo "  groups list-instances NAME     list instances in group"
        ;;
    esac
    ;;
  managed-group)
    mg_cmd=$1
    shift || true
    case "$mg_cmd" in
      describe)
        if [[ -z "$1" ]]; then
          echo "usage: gcloudt gce managed-group describe NAME [gcloud describe options...]" >&2
          exit 1
        fi
        gcloud compute instance-groups managed describe --region=asia-northeast1 "$@"
        ;;
      *)
        gcloud compute instance-groups managed list-instances --region=asia-northeast1 "$mg_cmd" "$@"
        ;;
    esac
    ;;
  #start) aws gce start-instances --instance-ids $(gce_get_id "$1") ;;
  #stop)  aws gce  stop-instances --instance-ids $(gce_get_id "$1") ;;
  *)
    echo "gce commands:"
    echo "  ls         list instances"
    echo "  ls --csv   list instances as csv"
    echo "  show NAME [opts]   instances describe (raw gcloud output)"
    echo "  images     list images"
    echo "  types      list Rocky Linux images (name ~ rocky-linux)"
    echo "  templates  list instance templates"
    echo "  template NAME [opts]   instance-templates describe (raw gcloud output)"
    echo "  groups                         list instance groups"
    echo "  groups describe NAME           instance-groups describe (or via backend-service)"
    echo "  groups list-instances NAME     list instances in group"
    echo "  managed-group NAME [opts]        instance-groups managed list-instances"
    echo "  managed-group describe NAME [opts]   instance-groups managed describe"
    echo "  start NAME"
    echo "  stop NAME"
  ;;
esac
