#!/usr/bin/env bash
set -e

cmd=$1
shift || true

eks_cluster_list_csv() {
  echo "Name,Version,Status,Endpoint,RoleArn,Created"
  aws eks list-clusters --output json | jq -r '.clusters[]' | while read cluster_name; do
    aws eks describe-cluster --name "$cluster_name" --query "cluster.[name,version,status,endpoint,roleArn,createdAt]" --output text | tr '\t' ','
  done
}

eks_addons_list_csv() {
  local cluster_name=$1
  if [[ -z "$cluster_name" ]]; then
    # すべてのクラスターを対象
    echo "Cluster,ClusterVersion,AddonName,AddonVersion,ServiceAccountRoleArn,Status,Created"
    aws eks list-clusters --output json | jq -r '.clusters[]' | while read cluster; do
      _eks_addons_for_cluster "$cluster"
    done
  else
    # 特定クラスターのみ
    echo "ClusterVersion,AddonName,AddonVersion,ServiceAccountRoleArn,Status,Created"
    local cluster_version=$(aws eks describe-cluster --name "$cluster_name" --query "cluster.version" --output text)
    aws eks list-addons --cluster-name "$cluster_name" --output json | jq -r '.addons[]' | while read addon_name; do
      aws eks describe-addon --cluster-name "$cluster_name" --addon-name "$addon_name" --query "addon.[addonName,addonVersion,serviceAccountRoleArn,status,createdAt]" --output text | sed "s/^/$cluster_version\t/" | tr '\t' ','
    done
  fi
}

_eks_addons_for_cluster() {
  local cluster=$1
  # クラスターバージョンを取得
  local cluster_version=$(aws eks describe-cluster --name "$cluster" --query "cluster.version" --output text)

  aws eks list-addons --cluster-name "$cluster" --output json | jq -r '.addons[]' | while read addon_name; do
    aws eks describe-addon --cluster-name "$cluster" --addon-name "$addon_name" --query "addon.[addonName,addonVersion,serviceAccountRoleArn,status,createdAt]" --output text | sed "s/^/$cluster\t$cluster_version\t/" | tr '\t' ','
  done
}

eks_describe_cluster() {
  local cluster_name=""
  local fmt="table"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name|--cluster-name)
        cluster_name="$2"
        shift 2
        ;;
      --json)
        fmt="json"
        shift
        ;;
      *)
        if [[ -z "$cluster_name" ]]; then
          cluster_name="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$cluster_name" ]]; then
    echo "usage: awst eks describe-cluster CLUSTER [--json]" >&2
    echo "       awst eks describe-cluster --name CLUSTER [--json]" >&2
    exit 1
  fi

  local json
  json="$(aws eks describe-cluster --name "$cluster_name" --output json)"

  if [[ "$fmt" == "json" ]]; then
    echo "$json" | jq .
  else
    echo "$json" | jq -r '
      .cluster |
      "Name: \(.name)",
      "ARN: \(.arn)",
      "Status: \(.status)",
      "Version: \(.version)",
      "PlatformVersion: \(.platformVersion // "-")",
      "Endpoint: \(.endpoint)",
      "RoleArn: \(.roleArn)",
      "VPC: \(.resourcesVpcConfig.vpcId // "-")",
      "Subnets: \(.resourcesVpcConfig.subnetIds | join(", "))",
      "SecurityGroups: \(.resourcesVpcConfig.securityGroupIds | join(", "))",
      "ClusterSecurityGroup: \(.resourcesVpcConfig.clusterSecurityGroupId // "-")",
      "EndpointPublicAccess: \(.resourcesVpcConfig.endpointPublicAccess)",
      "EndpointPrivateAccess: \(.resourcesVpcConfig.endpointPrivateAccess)",
      (if (.resourcesVpcConfig.publicAccessCidrs | length) > 0 then "PublicAccessCIDRs: \(.resourcesVpcConfig.publicAccessCidrs | join(", "))" else empty end),
      "ServiceIPv4CIDR: \(.kubernetesNetworkConfig.serviceIpv4Cidr // "-")",
      (if .identity.oidc then "OIDCIssuer: \(.identity.oidc.issuer)" else empty end),
      (if .encryptionConfig then "EncryptionConfig:" else empty end),
      (.encryptionConfig[]? | "  - \(.provider.keyArn) (\(.resources | join(", ")))"),
      (if .accessConfig then "AuthenticationMode: \(.accessConfig.authenticationMode // "-")" else empty end),
      (if (.health.issues | length) > 0 then "HealthIssues:" else empty end),
      (.health.issues[]? | "  - [\(.code)] \(.message)"),
      "CreatedAt: \(.createdAt)"
    '
  fi
}

eks_describe_nodegroup() {
  local cluster_name=""
  local nodegroup_name=""
  local fmt="table"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cluster-name)
        cluster_name="$2"
        shift 2
        ;;
      --nodegroup-name)
        nodegroup_name="$2"
        shift 2
        ;;
      --json)
        fmt="json"
        shift
        ;;
      *)
        if [[ -z "$cluster_name" ]]; then
          cluster_name="$1"
        elif [[ -z "$nodegroup_name" ]]; then
          nodegroup_name="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$cluster_name" || -z "$nodegroup_name" ]]; then
    echo "usage: awst eks describe-nodegroup CLUSTER NODEGROUP [--json]" >&2
    echo "       awst eks describe-nodegroup --cluster-name CLUSTER --nodegroup-name NODEGROUP [--json]" >&2
    exit 1
  fi

  local json
  json="$(aws eks describe-nodegroup \
    --cluster-name "$cluster_name" \
    --nodegroup-name "$nodegroup_name" \
    --output json)"

  if [[ "$fmt" == "json" ]]; then
    echo "$json" | jq .
  else
    echo "$json" | jq -r '
      .nodegroup |
      "NodegroupName: \(.nodegroupName)",
      "ClusterName: \(.clusterName)",
      "Status: \(.status)",
      "Version: \(.version)",
      "ReleaseVersion: \(.releaseVersion // "-")",
      "CapacityType: \(.capacityType // "-")",
      "InstanceTypes: \(.instanceTypes | join(", "))",
      "AMIType: \(.amiType // "-")",
      "Scaling: min=\(.scalingConfig.minSize) max=\(.scalingConfig.maxSize) desired=\(.scalingConfig.desiredSize)",
      "Subnets: \(.subnets | join(", "))",
      "NodeRole: \(.nodeRole)",
      (if .launchTemplate then "LaunchTemplate: \(.launchTemplate.name // .launchTemplate.id) (version \(.launchTemplate.version // "default"))" else empty end),
      (if .resources.autoScalingGroups then "AutoScalingGroups: \(.resources.autoScalingGroups | map(.name) | join(", "))" else empty end),
      (if (.health.issues | length) > 0 then "HealthIssues:" else empty end),
      (.health.issues[]? | "  - [\(.code)] \(.message)"),
      "CreatedAt: \(.createdAt)",
      "ModifiedAt: \(.modifiedAt // "-")"
    '
  fi
}

eks_addon_versions() {
  local addon_name=""
  local k8s_version=""
  local fmt="table"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --addon-name)
        addon_name="$2"
        shift 2
        ;;
      --kubernetes-version)
        k8s_version="$2"
        shift 2
        ;;
      --csv)
        fmt="--csv"
        shift
        ;;
      *)
        if [[ -z "$addon_name" ]]; then
          addon_name="$1"
        elif [[ -z "$k8s_version" ]]; then
          k8s_version="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$addon_name" || -z "$k8s_version" ]]; then
    echo "usage: awst eks addon-versions <addon-name> <kubernetes-version> [--csv]" >&2
    echo "       awst eks addon-versions --addon-name NAME --kubernetes-version VERSION [--csv]" >&2
    exit 1
  fi

  local json
  json="$(aws eks describe-addon-versions \
    --addon-name "$addon_name" \
    --kubernetes-version "$k8s_version" \
    --output json)"

  if [[ "$fmt" == "--csv" ]]; then
    echo "AddonName,AddonVersion,Default,Architectures"
    echo "$json" | jq -r --arg name "$addon_name" '
      .addons[]?.addonVersions[]? |
      [
        $name,
        .addonVersion,
        ((.compatibilities[]? | select(.defaultVersion == true) | .defaultVersion) // false),
        (.architecture | join(";"))
      ] | @csv'
  else
    echo -e "AddonName\tAddonVersion\tDefault\tArchitectures"
    echo "$json" | jq -r --arg name "$addon_name" '
      .addons[]?.addonVersions[]? |
      [
        $name,
        .addonVersion,
        ((.compatibilities[]? | select(.defaultVersion == true) | .defaultVersion) // false),
        (.architecture | join(","))
      ] | @tsv' | column -t -s $'\t'
  fi
}

case "$cmd" in
  list-clusters)
    if [[ "$1" == "--csv" ]]; then
      eks_cluster_list_csv
    else
      eks_cluster_list_csv | column -s, -t
    fi
    ;;
  update-kubeconfig)
    cluster_name=$1
    if [[ -z "$cluster_name" ]]; then
      echo "cluster name required"
      exit 1
    fi

    if [[ "$2" == "--dry-run" ]]; then
      aws eks update-kubeconfig --name "$cluster_name" --dry-run
    else
      aws eks update-kubeconfig --name "$cluster_name"
    fi
    ;;
  list-addons)
    cluster_name=$1
    csv_flag=$2
    if [[ "$cluster_name" == "--csv" ]]; then
      csv_flag=$1
      cluster_name=""
    fi

    if [[ "$csv_flag" == "--csv" ]]; then
      eks_addons_list_csv "$cluster_name"
    else
      eks_addons_list_csv "$cluster_name" | column -s, -t
    fi
    ;;
  addon-versions|describe-addon-versions)
    eks_addon_versions "$@"
    ;;
  describe-nodegroup)
    eks_describe_nodegroup "$@"
    ;;
  describe-cluster)
    eks_describe_cluster "$@"
    ;;
  *)
    echo "eks commands:"
    echo "  list-clusters                    list EKS clusters"
    echo "  list-clusters --csv              list EKS clusters as csv"
    echo "  list-addons [CLUSTER_NAME]       list EKS addons with versions (all clusters if not specified)"
    echo "  list-addons [CLUSTER_NAME] --csv list EKS addons as csv"
    echo "  addon-versions ADDON K8S_VERSION list available addon versions (describe-addon-versions)"
    echo "  addon-versions --addon-name NAME --kubernetes-version VERSION [--csv]"
    echo "  describe-cluster CLUSTER [--json]"
    echo "  describe-cluster --name CLUSTER [--json]"
    echo "  describe-nodegroup CLUSTER NODEGROUP [--json]"
    echo "  describe-nodegroup --cluster-name CLUSTER --nodegroup-name NODEGROUP [--json]"
    echo "  update-kubeconfig NAME           update kubeconfig for cluster"
    echo "  update-kubeconfig NAME --dry-run output kubeconfig to stdout"
    ;;
esac
