ecs_taskdef_ls_csv() {
  echo "Family,Revision,TaskDefinitionArn"
  echo "$1" | jq -r '
    .taskDefinitionArns[]? |
    (split("/") | last) as $fr |
    ($fr | split(":")) as $p |
    [ $p[0], ($p[1] // "-"), . ] | @tsv
  ' | tr '\t' ','
}

ecs_taskdef_ls_json() {
  echo "$1" | jq '
    [ .taskDefinitionArns[]? |
      (split("/") | last) as $fr |
      ($fr | split(":")) as $p |
      { Family: $p[0], Revision: ($p[1] // null), TaskDefinitionArn: . } ]
  '
}

ecs_taskdef_ls() {
  local family=""
  local status=""
  local sort="DESC"
  local max="100"
  local fmt="table"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --family) family="${2:-}"; shift 2 ;;
      --status) status="${2:-}"; shift 2 ;;
      --sort) sort="${2:-}"; shift 2 ;;
      --max) max="${2:-}"; shift 2 ;;
      --csv) fmt="csv"; shift ;;
      --json) fmt="json"; shift ;;
      *)
        echo "unknown option: $1 (awst ecs task-definition help)" >&2
        exit 1
        ;;
    esac
  done

  sort="${sort^^}"
  case "$sort" in
    ASC|DESC) ;;
    *)
      echo "--sort must be asc or desc: $sort" >&2
      exit 1
      ;;
  esac
  case "$status" in
    ""|ACTIVE|INACTIVE|DELETE) ;;
    *)
      echo "--status must be ACTIVE, INACTIVE, or DELETE: $status" >&2
      exit 1
      ;;
  esac
  if ! [[ "$max" =~ ^[0-9]+$ ]]; then
    echo "--max must be a positive integer: $max" >&2
    exit 1
  fi

  local -a cmd=(ecs list-task-definitions --sort "$sort" --max-items "$max" --output json)
  if [[ -n "$family" ]]; then
    cmd+=(--family-prefix "$family")
  fi
  if [[ -n "$status" ]]; then
    cmd+=(--status "$status")
  fi

  if [[ -n "${CLOUD_CLI_DEBUG:-}" ]]; then
    printf '%q ' aws "${cmd[@]}"; echo
    exit 0
  fi

  local json
  json="$(aws "${cmd[@]}")"

  case "$fmt" in
    json) ecs_taskdef_ls_json "$json" ;;
    csv) ecs_taskdef_ls_csv "$json" ;;
    table) ecs_taskdef_ls_csv "$json" | column -s, -t ;;
  esac
}

ecs_taskdef_show() {
  local name=""
  local fmt="table"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) fmt="json"; shift ;;
      *)
        if [[ -z "$name" ]]; then
          name="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$name" ]]; then
    echo "usage: awst ecs task-definition show <family[:revision]|arn> [--json]" >&2
    exit 1
  fi

  local -a cmd=(ecs describe-task-definition --task-definition "$name" --output json)
  if [[ -n "${CLOUD_CLI_DEBUG:-}" ]]; then
    printf '%q ' aws "${cmd[@]}"; echo
    exit 0
  fi

  local json
  json="$(aws "${cmd[@]}")"

  if [[ "$fmt" == "json" ]]; then
    echo "$json" | jq '.taskDefinition'
    return 0
  fi

  echo "$json" | jq -r '
    .taskDefinition |
    "Family: \(.family)",
    "Revision: \(.revision)",
    "Status: \(.status // "-")",
    "TaskDefinitionArn: \(.taskDefinitionArn)",
    "RequiresCompatibilities: \(if (.requiresCompatibilities // [] | length) > 0 then (.requiresCompatibilities | join(", ")) else "-" end)",
    "NetworkMode: \(.networkMode // "-")",
    "Cpu: \(.cpu // "-")",
    "Memory: \(.memory // "-")",
    "ExecutionRoleArn: \(.executionRoleArn // "-")",
    "TaskRoleArn: \(.taskRoleArn // "-")",
    "Volumes:",
    (if (.volumes // [] | length) > 0 then
      (.volumes[] | "  \(.name) host=\(.host.sourcePath // "-")")
    else "  (none)" end),
    "ContainerDefinitions:",
    (if (.containerDefinitions // [] | length) > 0 then
      (.containerDefinitions[] |
        "  [\(.name)] image=\(.image) essential=\(.essential // false) cpu=\(.cpu // "-") memory=\(.memory // "-")",
        (if (.portMappings // [] | length) > 0 then
          "    ports: \((.portMappings // []) | map("\(.containerPort)/\(.protocol // "tcp")\(if .hostPort then "->\(.hostPort)" else "" end)") | join(", "))"
        else empty end),
        (if (.environment // [] | length) > 0 then
          "    env: \((.environment // []) | map("\(.name)=\(.value)") | join(", "))"
        else empty end),
        (if (.secrets // [] | length) > 0 then
          "    secrets: \((.secrets // []) | map("\(.name)<-\(.valueFrom)") | join(", "))"
        else empty end),
        (if .logConfiguration then
          "    log: \(.logConfiguration.logDriver)\(if .logConfiguration.options then " " + ((.logConfiguration.options | to_entries) | map("\(.key)=\(.value)") | join(" ")) else "" end)"
        else empty end),
        (if (.mountPoints // [] | length) > 0 then
          "    mountPoints: \((.mountPoints // []) | map("\(.sourceVolume)->\(.containerPath)") | join(", "))"
        else empty end),
        (if (.dependsOn // [] | length) > 0 then
          "    dependsOn: \((.dependsOn // []) | map("\(.containerName):\(.condition)") | join(", "))"
        else empty end),
        (if .healthCheck then "    healthCheck: \(.healthCheck | tojson)" else empty end))
    else "  (none)" end)
  '
}

# describe-container-instances は最大 100 件ずつ。渡された ARN を分割して 1 つの JSON にまとめる。
ecs_describe_container_instances_json() {
  local cluster="$1"
  shift
  local -a arns=("$@")
  local -a out=()
  local i
  for ((i = 0; i < ${#arns[@]}; i += 100)); do
    local chunk=("${arns[@]:i:100}")
    out+=("$(aws ecs describe-container-instances --cluster "$cluster" --container-instances "${chunk[@]}" --output json)")
  done
  if [[ ${#out[@]} -eq 0 ]]; then
    echo '{"containerInstances":[],"failures":[]}'
    return 0
  fi
  printf '%s\n' "${out[@]}" | jq -s '{containerInstances: (map(.containerInstances) | add // []), failures: (map(.failures) | add // [])}'
}

ecs_ci_ls_csv() {
  echo "EC2InstanceId,Status,Agent,AgentVersion,Running,Pending,InstanceType,CPU,Memory"
  echo "$1" | jq -r '
    .containerInstances[]? |
    (([.attributes[]? | select(.name == "ecs.instance-type") | .value][0]) // "-") as $itype |
    (([.registeredResources[]? | select(.name == "CPU") | .integerValue][0]) // "-") as $cpu |
    (([.registeredResources[]? | select(.name == "MEMORY") | .integerValue][0]) // "-") as $mem |
    [
      .ec2InstanceId,
      (.status // "-"),
      (if .agentConnected then "connected" else "disconnected" end),
      (.versionInfo.agentVersion // .agentVersion // "-"),
      ((.runningTasksCount // 0) | tostring),
      ((.pendingTasksCount // 0) | tostring),
      ($itype | tostring),
      ($cpu | tostring),
      ($mem | tostring)
    ] | @tsv
  ' | tr '\t' ','
}

ecs_ci_ls_json() {
  echo "$1" | jq '
    [ .containerInstances[]? | {
        EC2InstanceId: .ec2InstanceId,
        Status: (.status // null),
        AgentConnected: (.agentConnected // false),
        AgentVersion: (.versionInfo.agentVersion // .agentVersion // null),
        RunningTasks: (.runningTasksCount // 0),
        PendingTasks: (.pendingTasksCount // 0),
        InstanceType: (([.attributes[]? | select(.name == "ecs.instance-type") | .value][0]) // null),
        RegisteredCpu: (([.registeredResources[]? | select(.name == "CPU") | .integerValue][0]) // null),
        RegisteredMemory: (([.registeredResources[]? | select(.name == "MEMORY") | .integerValue][0]) // null)
      } ]
  '
}

