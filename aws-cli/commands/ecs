ecs_ci_show() {
  local cluster=""
  local instance=""
  local fmt="table"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) fmt="json"; shift ;;
      *)
        if [[ -z "$cluster" ]]; then
          cluster="$1"
        elif [[ -z "$instance" ]]; then
          instance="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$cluster" || -z "$instance" ]]; then
    echo "usage: awst ecs container-instance show <cluster> <container-instance> [--json]" >&2
    exit 1
  fi

  local -a cmd=(ecs describe-container-instances --cluster "$cluster" --container-instances "$instance" --output json)
  if [[ -n "${CLOUD_CLI_DEBUG:-}" ]]; then
    printf '%q ' aws "${cmd[@]}"; echo
    exit 0
  fi

  local json
  json="$(aws "${cmd[@]}")"
  if [[ "$(echo "$json" | jq '.containerInstances | length')" == "0" ]]; then
    local reason
