    "ECSVersion: \(.version // "-")",
    "CapacityProvider: \(.capacityProviderName // "-")",
    "AvailabilityZone: \((.attributes[]? | select(.name == "ecs.availability-zone") | .value) // "-")",
    "InstanceType: \((.attributes[]? | select(.name == "ecs.instance-type") | .value) // "-")",
    "Running/Pending: \(.runningTasksCount // 0) / \(.pendingTasksCount // 0)",
    "RegisteredResources:",
    (if (.registeredResources // [] | length) > 0 then
      (.registeredResources[] | "  \(.name)=\(rv)")
    else "  (none)" end),
    "RemainingResources:",
    (if (.remainingResources // [] | length) > 0 then
      (.remainingResources[] | "  \(.name)=\(rv)")
    else "  (none)" end),
    "Attributes:",
    (if (.attributes // [] | length) > 0 then
      (.attributes[] | "  \(.name)=\(.value // "-")")
    else "  (none)" end)
  '
}

case "$sub" in
  cluster)
    cluster_cmd="${1:-}"
    shift || true
    case "$cluster_cmd" in
      ls|list)
        ecs_cluster_ls "$@"
        ;;
      show|describe)
        ecs_cluster_show "$@"
        ;;
      *)
        echo "cluster commands:"
        echo "  ls [--csv] [--json]        ECS クラスタ一覧を表示"
        echo "  show <cluster> [--json]    クラスタの詳細を表示"
        ;;
    esac
    ;;
  service|services)
    service_cmd="${1:-}"
    shift || true
    case "$service_cmd" in
      ls|list)
        ecs_service_ls "$@"
        ;;
      show|describe)
        ecs_service_show "$@"
        ;;
      *)
        echo "service commands:"
        echo "  ls <cluster> [--csv] [--json]       クラスタ内のサービス一覧を表示"
        echo "  show <cluster> <service> [--json]   サービスの詳細を表示"
        ;;
    esac
    ;;
  task-definition|td)
    td_cmd="${1:-}"
    shift || true
    case "$td_cmd" in
      ls|list)
        ecs_taskdef_ls "$@"
        ;;
      show|describe)
        ecs_taskdef_show "$@"
        ;;
      *)
        echo "task-definition commands:"
        echo "  ls [--family PREFIX] [--status ACTIVE|INACTIVE|DELETE] [--sort asc|desc] [--max N] [--csv] [--json]"
        echo "  show <family[:revision]|arn> [--json]"
        ;;
    esac
    ;;
  container-instance|ci)
    ci_cmd="${1:-}"
    shift || true
    case "$ci_cmd" in
      ls|list)
        ecs_ci_ls "$@"
        ;;
      show|describe)
        ecs_ci_show "$@"
        ;;
      *)
        echo "container-instance commands:"
        echo "  ls <cluster> [--csv] [--json]                      コンテナインスタンス一覧を表示"
        echo "  show <cluster> <container-instance> [--json]       コンテナインスタンスの詳細を表示"
        ;;
    esac
    ;;
  help|--help|-h|"")
    usage
    ;;
  *)
    echo "unknown ecs command: $sub" >&2
    usage >&2
    exit 1
    ;;
esac
