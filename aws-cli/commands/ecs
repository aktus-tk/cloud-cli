    exit 1
  fi

  if [[ "$fmt" == "json" ]]; then
    echo "$json" | jq '.containerInstances[0]'
    return 0
  fi

  echo "$json" | jq -r '
    def rv:
      if .integerValue != null then (.integerValue | tostring)
      elif .stringSetValue != null then (.stringSetValue | join(","))
      elif .doubleValue != null then (.doubleValue | tostring)
      else "-" end;
    .containerInstances[0] |
    "EC2InstanceId: \(.ec2InstanceId)",
    "ContainerInstanceArn: \(.containerInstanceArn)",
    "Status: \(.status // "-")",
    "AgentConnected: \(.agentConnected // false)",
