#!/usr/bin/env bash
set -eo pipefail

sub="${1:-}"
shift || true

usage() {
  cat <<EOF
usage: awst ecs <command> [args]

Amazon ECS の参照（読み取り専用）

commands:
  cluster ls [--csv] [--json]                 ECS クラスタ一覧を表示
  cluster show <cluster> [--json]             クラスタの詳細を表示
  service ls <cluster> [--csv] [--json]       クラスタ内のサービス一覧を表示
  service show <cluster> <service> [--json]   サービスの詳細を表示
  task-definition ls [--family PREFIX] [--status ACTIVE|INACTIVE|DELETE] [--csv] [--json]
                                              タスク定義一覧を表示
  task-definition show <family[:revision]|arn> [--json]
                                              タスク定義の詳細を表示
  container-instance ls <cluster> [--csv] [--json]
                                              EC2 起動タイプのコンテナインスタンス一覧を表示
  container-instance show <cluster> <container-instance> [--json]
                                              コンテナインスタンスの詳細を表示

aliases:
  td   task-definition と同じ（例: awst ecs td ls）
  ci   container-instance と同じ（例: awst ecs ci ls my-cluster）

examples:
  awst ecs cluster ls
  awst ecs cluster show RHEMS-FileStorage-Cluster
  awst ecs service ls RHEMS-FileStorage-Cluster
  awst ecs service ls RHEMS-FileStorage-Cluster --csv
  awst ecs service show RHEMS-FileStorage-Cluster my-service
  awst ecs service show RHEMS-FileStorage-Cluster my-service --json
  awst ecs task-definition ls
  awst ecs task-definition ls --family web
  awst ecs task-definition show web:12
  awst ecs container-instance ls RHEMS-FileStorage-Cluster
  awst ecs container-instance show RHEMS-FileStorage-Cluster i-0598e29e871a813bd
EOF
}

# describe-clusters は最大 100 件ずつ。渡された ARN を分割して 1 つの JSON にまとめる。
ecs_describe_clusters_json() {
  local -a arns=("$@")
  local -a out=()
  local i
  for ((i = 0; i < ${#arns[@]}; i += 100)); do
    local chunk=("${arns[@]:i:100}")
    out+=("$(aws ecs describe-clusters --clusters "${chunk[@]}" --output json)")
  done
  if [[ ${#out[@]} -eq 0 ]]; then
    echo '{"clusters":[],"failures":[]}'
    return 0
  fi
  printf '%s\n' "${out[@]}" | jq -s '{clusters: (map(.clusters) | add // []), failures: (map(.failures) | add // [])}'
}

# describe-services は最大 10 件ずつ。渡された ARN を分割して 1 つの JSON にまとめる。
ecs_describe_services_json() {
  local cluster="$1"
  shift
  local -a arns=("$@")
  local -a out=()
  local i
  for ((i = 0; i < ${#arns[@]}; i += 10)); do
    local chunk=("${arns[@]:i:10}")
    out+=("$(aws ecs describe-services --cluster "$cluster" --services "${chunk[@]}" --output json)")
  done
  if [[ ${#out[@]} -eq 0 ]]; then
    echo '{"services":[],"failures":[]}'
    return 0
  fi
  printf '%s\n' "${out[@]}" | jq -s '{services: (map(.services) | add // []), failures: (map(.failures) | add // [])}'
}

ecs_cluster_ls_csv() {
  echo "Name,Status,ActiveServices,RunningTasks,PendingTasks,RegisteredInstances,CapacityProviders"
  echo "$1" | jq -r '
    .clusters[]? |
    [
      .clusterName,
      (.status // "-"),
      ((.activeServicesCount // 0) | tostring),
      ((.runningTasksCount // 0) | tostring),
      ((.pendingTasksCount // 0) | tostring),
      ((.registeredContainerInstancesCount // 0) | tostring),
      ((.capacityProviders // []) | join(";"))
    ] | @tsv
  ' | tr '\t' ','
}

ecs_cluster_ls_json() {
  echo "$1" | jq '
    [ .clusters[]? | {
        Name: .clusterName,
        Status: (.status // null),
        ActiveServices: (.activeServicesCount // 0),
        RunningTasks: (.runningTasksCount // 0),
        PendingTasks: (.pendingTasksCount // 0),
        RegisteredInstances: (.registeredContainerInstancesCount // 0),
        CapacityProviders: (.capacityProviders // [])
      } ]
  '
}

ecs_cluster_ls() {
  local fmt="table"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --csv) fmt="csv"; shift ;;
      --json) fmt="json"; shift ;;
      *)
        echo "unknown option: $1 (awst ecs cluster help)" >&2
        exit 1
        ;;
    esac
  done

  if [[ -n "${CLOUD_CLI_DEBUG:-}" ]]; then
    printf '%q ' aws ecs list-clusters --output json; echo
    printf '%q ' aws ecs describe-clusters --clusters '<cluster-arns>' --output json; echo
    exit 0
  fi

  local arns
  arns="$(aws ecs list-clusters --output json | jq -r '.clusterArns[]?')"
  local -a arr=()
  if [[ -n "$arns" ]]; then
    mapfile -t arr <<<"$arns"
  fi

  local json
  json="$(ecs_describe_clusters_json "${arr[@]}")"

  case "$fmt" in
    json) ecs_cluster_ls_json "$json" ;;
    csv) ecs_cluster_ls_csv "$json" ;;
    table) ecs_cluster_ls_csv "$json" | column -s, -t ;;
  esac
}

ecs_cluster_show() {
  local name=""
  local fmt="table"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) fmt="json"; shift ;;
      *)
        if [[ -z "$name" ]]; then
          name="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$name" ]]; then
    echo "usage: awst ecs cluster show <cluster> [--json]" >&2
    exit 1
  fi

  local -a cmd=(ecs describe-clusters --clusters "$name" --output json)
  if [[ -n "${CLOUD_CLI_DEBUG:-}" ]]; then
    printf '%q ' aws "${cmd[@]}"; echo
    exit 0
  fi

  local json
  json="$(aws "${cmd[@]}")"
  if [[ "$(echo "$json" | jq '.clusters | length')" == "0" ]]; then
    local reason
    reason="$(echo "$json" | jq -r '.failures[0].reason // empty')"
    echo "ECS cluster not found: $name${reason:+ ($reason)}" >&2
    exit 1
  fi

  if [[ "$fmt" == "json" ]]; then
    echo "$json" | jq '.clusters[0]'
    return 0
  fi

  echo "$json" | jq -r '
    .clusters[0] |
    "Name: \(.clusterName)",
    "Arn: \(.clusterArn)",
    "Status: \(.status // "-")",
    "ActiveServices: \(.activeServicesCount // 0)",
    "RunningTasks: \(.runningTasksCount // 0)",
    "PendingTasks: \(.pendingTasksCount // 0)",
    "RegisteredInstances: \(.registeredContainerInstancesCount // 0)",
    "CapacityProviders: \(if (.capacityProviders // [] | length) > 0 then (.capacityProviders | join(", ")) else "-" end)",
    "DefaultCapacityProviderStrategy:",
    (if (.defaultCapacityProviderStrategy // [] | length) > 0 then
      (.defaultCapacityProviderStrategy[] | "  \(.capacityProvider) weight=\(.weight // "-") base=\(.base // "-")")
    else "  (none)" end),
    "Settings:",
    (if (.settings // [] | length) > 0 then
      (.settings[] | "  \(.name)=\(.value // "-")")
    else "  (none)" end)
  '
}

