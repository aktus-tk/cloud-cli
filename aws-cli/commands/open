#!/usr/bin/env bash
set -e

SERVICE_MAP_URL="https://raw.githubusercontent.com/fwdcloudsec/granted/refs/heads/main/pkg/console/service_map.go"

usage() {
  cat <<EOF
usage: awst open [SERVICE | --servicemap]

granted（assume）経由で AWS マネジメントコンソールを開く。

AWS_PROFILE が必要（例: プロジェクトディレクトリの direnv .envrc で設定）。

--print-url を付けるとブラウザを起動せず、署名済みログイン URL を stdout に
出力する。URL には一時認証が埋め込まれているため、ログやファイルに残さず
そのままブラウザへ渡して消費すること。

examples:
  awst open .                        デフォルトのコンソールを開く
  awst open s3                       S3 コンソールを開く
  awst open acm --region us-east-1   ACM コンソール（us-east-1）を開く
  awst open s3 --print-url           S3 コンソールのログイン URL を出力
  awst open --servicemap             利用可能なサービス一覧を表示

granted のセットアップは README_granted.md を参照。
EOF
}

show_servicemap() {
  local body
  if ! body="$(curl -fsSL "$SERVICE_MAP_URL")"; then
    echo "failed to fetch service map from $SERVICE_MAP_URL" >&2
    exit 1
  fi

  {
    printf 'Alias\tConsole\n'
    echo "$body" | sed -n 's/^[[:space:]]*"\([^"]*\)"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1\t\2/p' \
      | awk -F'\t' '{ if ($1 == "") $1 = "."; print }' \
      | sort -t $'\t' -k1,1
  } | column -t -s $'\t'
}

require_profile() {
  if [[ -z "${AWS_PROFILE:-}" ]]; then
    echo "AWS_PROFILE is not set (use direnv or export AWS_PROFILE=...)" >&2
    exit 1
  fi
}

require_assume() {
  if ! command -v assume >/dev/null 2>&1; then
    echo "assume not found (install granted: see README_granted.md)" >&2
    exit 1
  fi
}

# awst strips --region and exports AWS_REGION; forward it to assume.
region_args=()
if [[ -n "${AWS_REGION:-}" ]]; then
  region_args+=(--region "$AWS_REGION")
elif [[ -n "${AWS_DEFAULT_REGION:-}" ]]; then
  region_args+=(--region "$AWS_DEFAULT_REGION")
fi

# --print-url: URL を stdout に出力（granted の -u）。ブラウザは開かない。
# 任意の位置に書けるよう引数から除去する。
console_mode=(-c)
_args=()
for _a in "$@"; do
  if [[ "$_a" == "--print-url" ]]; then
    console_mode=(-u)
  else
    _args+=("$_a")
  fi
done
set -- "${_args[@]}"

case "${1:-}" in
  help|--help|-h)
    usage
    ;;
  --servicemap)
    show_servicemap
    ;;
  .)
    shift || true
    require_profile
    require_assume
    exec assume "$AWS_PROFILE" "${console_mode[@]}" "${region_args[@]}" "$@"
    ;;
  -*)
    require_profile
    require_assume
    exec assume "$AWS_PROFILE" "${console_mode[@]}" "${region_args[@]}" "$@"
    ;;
  "")
    require_profile
    require_assume
    exec assume "$AWS_PROFILE" "${console_mode[@]}" "${region_args[@]}"
    ;;
  *)
    require_profile
    require_assume
    exec assume "$AWS_PROFILE" "${console_mode[@]}" -s "$1" "${region_args[@]}" "${@:2}"
    ;;
esac
