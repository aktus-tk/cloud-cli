#!/usr/bin/env bash
set -eo pipefail

_lib="$(dirname "$0")/_lib"
# shellcheck source=_lib/ec2_regions.sh
source "${_lib}/ec2_regions.sh"

sub="${1:-}"
shift || true

usage() {
  cat <<'EOF'
usage: awst sg <command> [args]

EC2 セキュリティグループの調査（読み取り専用）。
一覧・存在確認は awst sg。ルールを CSV で一括ダンプする場合は awst ec2 sg_rules（現リージョンのみ）。

commands:
  ls [options]                 SG 一覧（Region / GroupName / GroupId / VpcId / Description / Tags）
  show <sg-id|group-name>      1 つの SG の Inbound / Outbound ルール（人が読む形式）
  ec2 <instance-name-or-id>    EC2 インスタンスにアタッチされている SG
  alb <alb-name>               ALB にアタッチされている SG ID
  check <src> <dst> <port>     src → dst の TCP が論理的に通るか（SG ルールの組み合わせ）
  check alb <alb> <dst> <port> src = その ALB の SG 群

ls のリージョンの決め方:
  デフォルト     現在のリージョン 1 つだけ（AWS_REGION / aws configure get region）
  1 リージョン   awst --region ap-northeast-1 sg ls
  全リージョン   awst sg ls --all-regions
                 （awst ec2 regions と同じ describe-regions 一覧を順に問い合わせ。
                   ヘッダは 1 回。SG が無いリージョンは行なし。失敗リージョンは最後に stderr）

ls options:
  --all-regions    アカウントで有効な全 EC2 リージョンを横断（Cost Explorer / Resource Explorer は使わない）
  --csv            CSV 出力（--all-regions と併用可）
  --detail         SG ごとにルール概要付きブロック（件数が多いと長い）

check の意味:
  src 側 SG のいずれかに、dst（SG または 0.0.0.0/0）向けの egress があり、
  かつ dst 側 SG のいずれかに、src（SG または 0.0.0.0/0）からの ingress があり、
  指定 TCP ポートが許可されていれば ALLOW。

examples:
  awst sg ls
  awst --region ap-northeast-1 sg ls
  awst sg ls --all-regions
  awst sg ls --all-regions --csv
  awst sg ls --detail
  awst sg show app-sg
  awst sg ec2 web01
  awst sg alb my-alb
  awst sg check alb my-alb web01 443
  awst sg check sg-aaa01234 sg-bbb01234 443
EOF
}

get_alb_arn_by_name() {
  local name="$1"
  local arn
  arn="$(aws elbv2 describe-load-balancers --names "$name" \
    --query 'LoadBalancers[0].LoadBalancerArn' --output text 2>/dev/null || true)"
  if [[ -z "$arn" || "$arn" == "None" ]]; then
    echo "ALB not found: $name" >&2
    return 1
  fi
  printf '%s' "$arn"
}

resolve_sg_ids() {
  local spec="$1"
  if [[ "$spec" =~ ^sg-[0-9a-f]+$ ]]; then
    echo "$spec"
    return 0
  fi
  if [[ "$spec" =~ ^i-[0-9a-f]+$ ]]; then
    aws ec2 describe-instances --instance-ids "$spec" \
      --query 'Reservations[].Instances[].SecurityGroups[].GroupId' --output text |
      tr '\t' '\n' | sort -u
    return 0
  fi

  local iids
  iids="$(aws ec2 describe-instances \
    --filters "Name=tag:Name,Values=$spec" \
    --query 'Reservations[].Instances[].InstanceId' --output text 2>/dev/null || true)"
  if [[ -n "$iids" ]]; then
    local first
    first="$(echo "$iids" | awk '{print $1}')"
    resolve_sg_ids "$first"
    return 0
  fi

  local gids
  gids="$(aws ec2 describe-security-groups --filters "Name=group-name,Values=$spec" \
    --query 'SecurityGroups[].GroupId' --output text 2>/dev/null || true)"
  if [[ -n "$gids" ]]; then
    echo "$gids" | tr '\t' '\n'
    return 0
  fi

  echo "could not resolve security group reference: $spec" >&2
  return 1
}

resolve_alb_src_sg_ids() {
  local alb_name="$1"
  local arn
  arn="$(get_alb_arn_by_name "$alb_name")"
  aws elbv2 describe-load-balancers --load-balancer-arns "$arn" \
    --query 'LoadBalancers[0].SecurityGroups[]' --output text | tr '\t' '\n' | sed '/^$/d'
}

sg_effective_region() {
  if [[ -n "${AWS_REGION:-}" ]]; then
    printf '%s' "$AWS_REGION"
    return 0
  fi
  if [[ -n "${AWS_DEFAULT_REGION:-}" ]]; then
    printf '%s' "$AWS_DEFAULT_REGION"
    return 0
  fi
  local configured
  configured="$(aws configure get region 2>/dev/null || true)"
  if [[ -n "$configured" ]]; then
    printf '%s' "$configured"
    return 0
  fi
  printf '%s' ''
}

sg_ls_print_header() {
  local detail=$1 csv=$2
  if [[ "$detail" == true ]]; then
    return 0
  fi
  if [[ "$csv" == true ]]; then
    echo "Region,GroupName,GroupId,VpcId,Description,Tags"
  else
    echo -e "Region\tGroupName\tGroupId\tVpcId\tDescription\tTags"
  fi
}

# Emit SG rows for the current AWS_REGION (no table header). Returns non-zero if describe fails.
sg_ls_emit() {
  local detail=$1 csv=$2
  local region
  region="$(sg_effective_region)"

  local err data
  err="$(mktemp)"
  if ! data="$(aws ec2 describe-security-groups --output json 2>"$err")"; then
    cat "$err" >&2
    rm -f "$err"
    return 1
  fi
  rm -f "$err"

  if [[ "$detail" == true ]]; then
    echo "$data" | jq -c '.SecurityGroups[]' | while read -r sg; do
      local name gid vpcid desc tags
      name="$(echo "$sg" | jq -r '.GroupName')"
      gid="$(echo "$sg" | jq -r '.GroupId')"
      vpcid="$(echo "$sg" | jq -r '.VpcId')"
      desc="$(echo "$sg" | jq -r '.Description')"
      tags="$(echo "$sg" | jq -r '((.Tags // []) | map("\(.Key)=\(.Value)") | join(","))')"
      echo "---"
      echo -e "Region\tGroupName\tGroupId\tVpcId\tDescription\tTags"
      echo -e "$region\t$name\t$gid\t$vpcid\t$desc\t$tags" | column -t -s $'\t'
      echo ""

      local in_count out_count
      in_count="$(echo "$sg" | jq '.IpPermissions | length')"
      out_count="$(echo "$sg" | jq '.IpPermissionsEgress | length')"
      if [[ "$in_count" -gt 0 ]]; then
        echo "  Inbound:"
        echo -e "  Dir\tProto\tPorts\tSource"
        echo "$sg" | jq -c '.IpPermissions[]?' 2>/dev/null | while read -r row; do
          [[ -z "$row" ]] && continue
          echo "$row" | sg_show_one_perm_line "IN"
        done | column -t -s $'\t' || true
      fi
      if [[ "$out_count" -gt 0 ]]; then
        echo "  Outbound:"
        echo -e "  Dir\tProto\tPorts\tDestination"
        echo "$sg" | jq -c '.IpPermissionsEgress[]?' 2>/dev/null | while read -r row; do
          [[ -z "$row" ]] && continue
          echo "$row" | sg_show_one_perm_line "OUT"
        done | column -t -s $'\t' || true
      fi
      echo ""
    done
  elif [[ "$csv" == true ]]; then
    echo "$data" | jq -r --arg region "$region" '.SecurityGroups[] |
      [
        $region,
        .GroupName,
        .GroupId,
        .VpcId,
        .Description,
        ((.Tags // []) | map("\(.Key)=\(.Value)") | join(","))
      ] | @tsv' | tr '\t' ','
  else
    echo "$data" | jq -r --arg region "$region" '.SecurityGroups[] |
      [
        $region,
        .GroupName,
        .GroupId,
        .VpcId,
        .Description,
        ((.Tags // []) | map("\(.Key)=\(.Value)") | join(","))
      ] | @tsv' |
      column -t -s $'\t'
  fi
}

sg_ls_all_regions() {
  local detail=$1 csv=$2
  local -a failures=()
  local -a regions=()
  local regions_err regions_tmp

  regions_tmp="$(mktemp)"
  regions_err="$(mktemp)"
  if ! aws_ec2_enabled_regions_list >"$regions_tmp" 2>"$regions_err"; then
    echo "awst sg ls --all-regions: could not list regions: $(tr '\n' ' ' <"$regions_err")" >&2
    rm -f "$regions_tmp" "$regions_err"
    return 1
  fi
  rm -f "$regions_err"
  mapfile -t regions <"$regions_tmp"
  rm -f "$regions_tmp"

  if [[ "$detail" != true ]]; then
    sg_ls_print_header "$detail" "$csv"
  fi

  local reg err_capture err_msg
  for reg in "${regions[@]}"; do
    [[ -z "$reg" ]] && continue
    err_capture="$(mktemp)"
    if ! AWS_REGION="$reg" AWS_DEFAULT_REGION="$reg" sg_ls_emit "$detail" "$csv" 2>"$err_capture"; then
      err_msg="$(tr '\n' ' ' <"$err_capture" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/[[:space:]]\+/ /g')"
      [[ -z "$err_msg" ]] && err_msg="describe-security-groups failed"
      failures+=("${reg}: ${err_msg}")
    fi
    rm -f "$err_capture"
  done

  if [[ ${#failures[@]} -gt 0 ]]; then
    echo "awst sg ls --all-regions: failed region(s):" >&2
    local f
    for f in "${failures[@]}"; do
      echo "  $f" >&2
    done
    return 1
  fi
}

sg_ls() {
  local detail=false
  local csv=false
  local all_regions=false
  local -a unknown=()
  for arg in "$@"; do
    case "$arg" in
      --detail) detail=true ;;
      --csv) csv=true ;;
      --all-regions) all_regions=true ;;
      -*) unknown+=("$arg") ;;
      *) unknown+=("$arg") ;;
    esac
  done

  if [[ ${#unknown[@]} -gt 0 ]]; then
    echo "awst sg ls: unknown argument(s): ${unknown[*]}" >&2
    echo "Usage: awst sg ls [--detail] [--csv] [--all-regions]" >&2
    return 2
  fi

  if [[ "$all_regions" == true ]]; then
    sg_ls_all_regions "$detail" "$csv"
    return
  fi

  sg_ls_print_header "$detail" "$csv"
  sg_ls_emit "$detail" "$csv"
}

sg_show_one_perm_line() {
  local direction="$1"
  jq -r --arg d "$direction" '
    def with_desc($desc): if ($desc // "") == "" then "" else " (\($desc))" end;
    . as $rule |
    ($rule.IpProtocol // "tcp") as $proto |
    (
      if ($proto == "-1") then "all"
      elif ($rule.FromPort == null and $rule.ToPort == null) then "all"
      else "\($rule.FromPort)-\($rule.ToPort)"
      end
    ) as $range |
    (
      [ $rule.IpRanges[]? | "CIDR=\(.CidrIp)\(with_desc(.Description))" ] +
      [ $rule.UserIdGroupPairs[]? | "SG=\(.GroupId)\(with_desc(.GroupName // .Description))" ] +
      [ $rule.PrefixListIds[]? | "PL=\(.PrefixListId)\(with_desc(.Description))" ]
    ) | if length > 0 then . else ["(none listed)"] end
    | .[] |
    "\($d)\t\($proto)\t\($range)\t\(.)"
  '
}

sg_show() {
  local key="${1:-}"
  if [[ -z "$key" ]]; then
    echo "Usage: awst sg show <sg-id|group-name>" >&2
    exit 1
  fi

  local gid
  if [[ "$key" =~ ^sg- ]]; then
    gid="$key"
  else
    gid="$(aws ec2 describe-security-groups --filters "Name=group-name,Values=$key" \
      --query 'SecurityGroups[0].GroupId' --output text 2>/dev/null || true)"
    if [[ -z "$gid" || "$gid" == "None" ]]; then
      echo "Security group not found: $key" >&2
      exit 1
    fi
  fi

  local json
  json="$(aws ec2 describe-security-groups --group-ids "$gid" --output json)"
  echo "$json" | jq -r '.SecurityGroups[0] |
    "GroupId: \(.GroupId)",
    "GroupName: \(.GroupName)",
    "VpcId: \(.VpcId)",
    "Description: \(.Description)",
    ""'

  echo "=== Inbound ==="
  echo -e "Dir\tProto\tPorts\tSource"
  echo "$json" | jq -c '.SecurityGroups[0].IpPermissions[]?' 2>/dev/null | while read -r row; do
    [[ -z "$row" ]] && continue
    echo "$row" | sg_show_one_perm_line "IN"
  done | column -t -s $'\t' || true

  echo ""
  echo "=== Outbound ==="
  echo -e "Dir\tProto\tPorts\tDestination"
  echo "$json" | jq -c '.SecurityGroups[0].IpPermissionsEgress[]?' 2>/dev/null | while read -r row; do
    [[ -z "$row" ]] && continue
    echo "$row" | sg_show_one_perm_line "OUT"
  done | column -t -s $'\t' || true
}

sg_ec2() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "Usage: awst sg ec2 <instance-name-or-id>" >&2
    exit 1
  fi

  local iid="$name"
  if [[ ! "$name" =~ ^i- ]]; then
    iid="$(aws ec2 describe-instances --filters "Name=tag:Name,Values=$name" \
      --query 'Reservations[].Instances[].InstanceId' --output text | awk '{print $1}')"
  fi
  if [[ -z "$iid" || "$iid" == "None" ]]; then
    echo "Instance not found: $name" >&2
    exit 1
  fi

  echo -e "InstanceId\tSecurityGroupIds"
  aws ec2 describe-instances --instance-ids "$iid" \
    --query 'Reservations[].Instances[].[InstanceId,join(`,`, SecurityGroups[].GroupId)]' \
    --output text | column -t -s $'\t'
}

sg_alb() {
  local alb_name="${1:-}"
  if [[ -z "$alb_name" ]]; then
    echo "Usage: awst sg alb <alb-name>" >&2
    exit 1
  fi
  local arn
  arn="$(get_alb_arn_by_name "$alb_name")"
  local ids
  ids="$(aws elbv2 describe-load-balancers --load-balancer-arns "$arn" \
    --query 'LoadBalancers[0].SecurityGroups' --output text | tr '\t' ' ')"

  echo "LoadBalancerName: $alb_name"
  echo "SecurityGroupIds: ${ids:-}"
}

# Shared logical path evaluation (TCP port, src SG set × dst SG set)
sg_pair_eval() {
  local port="$1"
  local data="$2"
  local src_json="$3"
  local dst_json="$4"

  echo "$data" | jq -r --argjson p "$port" --argjson src "$src_json" --argjson dst "$dst_json" '
    def port_ok($fp; $tp; $want; $proto):
      if ($proto == "-1") then true
      elif ($fp == null and $tp == null) then true
      else ($want >= $fp and $want <= $tp)
      end;

    def proto_tcp_ok($proto):
      ($proto == "tcp") or ($proto == "6") or ($proto == "-1");

    def cidr_any($ranges):
      (($ranges // []) | map(.CidrIp) | index("0.0.0.0/0")) != null;

    def sg_refs_overlap($pairs; $cands):
      (($pairs // []) | map(.GroupId)) as $gids |
      (($cands // []) | map(. as $c | ($gids | index($c) != null)) | any);

    def ingress_ok($rule; $srcs; $port):
      proto_tcp_ok($rule.IpProtocol) and
      port_ok($rule.FromPort; $rule.ToPort; $port; $rule.IpProtocol) and
      (cidr_any($rule.IpRanges) or sg_refs_overlap($rule.UserIdGroupPairs; $srcs));

    def egress_ok($rule; $dsts; $port):
      proto_tcp_ok($rule.IpProtocol) and
      port_ok($rule.FromPort; $rule.ToPort; $port; $rule.IpProtocol) and
      (cidr_any($rule.IpRanges) or sg_refs_overlap($rule.UserIdGroupPairs; $dsts));

    def any_ingress($sg; $srcs; $port):
      ($sg.IpPermissions // []) | map(select(ingress_ok(.; $srcs; $port))) | length > 0;

    def any_egress($sg; $dsts; $port):
      ($sg.IpPermissionsEgress // []) | map(select(egress_ok(.; $dsts; $port))) | length > 0;

    ($src) as $S |
    ($dst) as $D |
    [.SecurityGroups[] | select(.GroupId as $g | $S | index($g))] as $srcSgs |
    [.SecurityGroups[] | select(.GroupId as $g | $D | index($g))] as $dstSgs |
    if ($srcSgs | length) == 0 or ($dstSgs | length) == 0 then
      "error: missing security group data for resolved ids"
    else
      [
        range(0; $srcSgs | length) as $i |
        range(0; $dstSgs | length) as $j |
        {
          src: $srcSgs[$i].GroupId,
          dst: $dstSgs[$j].GroupId,
          egressOK: any_egress($srcSgs[$i]; $D; $p),
          ingressOK: any_ingress($dstSgs[$j]; $S; $p)
        }
      ] as $pairs |
      ($pairs | map(select(.egressOK and .ingressOK)) | .[0]) as $hit |
      if $hit then
        "ALLOW: pair \($hit.src) → \($hit.dst): egress+ingress allow TCP \($p) (SG peer or 0.0.0.0/0)"
      else
        ($pairs | map(select(.egressOK | not)) | .[0] // null) as $e1 |
        ($pairs | map(select(.ingressOK | not)) | .[0] // null) as $e2 |
        if $e1 != null then
          "DENY: src \($e1.src) has no egress rule to reach dst set on TCP \($p) (peer dst SG or 0.0.0.0/0)"
        elif $e2 != null then
          "DENY: dst \($e2.dst) has no ingress from src set on TCP \($p) (peer src SG or 0.0.0.0/0)"
        else
          "DENY: no src/dst pair satisfied for TCP \($p)"
        end
      end
    end
  '
}

sg_check_run() {
  local src_spec="$1"
  local dst_spec="$2"
  local port="$3"

  if ! [[ "$port" =~ ^[0-9]+$ ]] || [[ "$port" -lt 1 || "$port" -gt 65535 ]]; then
    echo "port must be 1-65535: $port" >&2
    exit 1
  fi

  mapfile -t src_ids < <(resolve_sg_ids "$src_spec" | sort -u)
  mapfile -t dst_ids < <(resolve_sg_ids "$dst_spec" | sort -u)

  if [[ ${#src_ids[@]} -eq 0 || ${#dst_ids[@]} -eq 0 ]]; then
    exit 1
  fi

  local -a uniq=()
  mapfile -t uniq < <(printf '%s\n' "${src_ids[@]}" "${dst_ids[@]}" | sort -u)
  local data
  data="$(aws ec2 describe-security-groups --group-ids "${uniq[@]}" --output json)"

  local src_json dst_json result
  src_json="$(jq -n --args '$ARGS.positional' "${src_ids[@]}")"
  dst_json="$(jq -n --args '$ARGS.positional' "${dst_ids[@]}")"
  result="$(sg_pair_eval "$port" "$data" "$src_json" "$dst_json")"

  echo "$result"
  if [[ "$result" == ALLOW:* ]]; then
    return 0
  fi
  return 1
}

sg_check_alb() {
  local alb_name="$1"
  local dst_spec="$2"
  local port="$3"

  if ! [[ "$port" =~ ^[0-9]+$ ]] || [[ "$port" -lt 1 || "$port" -gt 65535 ]]; then
    echo "port must be 1-65535: $port" >&2
    exit 1
  fi

  mapfile -t src_ids < <(resolve_alb_src_sg_ids "$alb_name" | sort -u)
  if [[ ${#src_ids[@]} -eq 0 ]]; then
    echo "no security groups on ALB: $alb_name" >&2
    exit 1
  fi

  mapfile -t dst_ids < <(resolve_sg_ids "$dst_spec" | sort -u)
  if [[ ${#dst_ids[@]} -eq 0 ]]; then
    exit 1
  fi

  local -a uniq=()
  mapfile -t uniq < <(printf '%s\n' "${src_ids[@]}" "${dst_ids[@]}" | sort -u)
  local data src_json dst_json result
  data="$(aws ec2 describe-security-groups --group-ids "${uniq[@]}" --output json)"
  src_json="$(jq -n --args '$ARGS.positional' "${src_ids[@]}")"
  dst_json="$(jq -n --args '$ARGS.positional' "${dst_ids[@]}")"
  result="$(sg_pair_eval "$port" "$data" "$src_json" "$dst_json")"

  echo "$result"
  if [[ "$result" == ALLOW:* ]]; then
    return 0
  fi
  return 1
}

case "$sub" in
  ls|list)
    sg_ls "$@"
    ;;
  show)
    sg_show "$@"
    ;;
  ec2)
    sg_ec2 "$@"
    ;;
  alb)
    sg_alb "$@"
    ;;
  check)
    if [[ "${1:-}" == "alb" ]]; then
      [[ $# -ge 4 ]] || { echo "Usage: awst sg check alb <alb-name> <dst> <port>" >&2; exit 1; }
      sg_check_alb "$2" "$3" "$4"
    else
      [[ $# -ge 3 ]] || { echo "Usage: awst sg check <src> <dst> <port>" >&2; echo "       awst sg check alb <alb-name> <dst> <port>" >&2; exit 1; }
      sg_check_run "$1" "$2" "$3"
    fi
    ;;
  help|--help|-h|"")
    usage
    ;;
  *)
    echo "unknown sg command: $sub" >&2
    usage >&2
    exit 1
    ;;
esac
