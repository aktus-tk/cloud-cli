#!/usr/bin/env bash
set -eo pipefail

sub="${1:-}"
shift || true

usage() {
  cat <<EOF
usage: awst secrets <command> [args]

AWS Secrets Manager

commands:
  ls [--csv]                      list all secrets
  show <name>                     show secret metadata (tags, rotation, etc.)
  get <name> [--json] [--field KEY] [--version ID]  get secret value
  create <name> <options>         create a new secret
  update <name> <options>         update secret value
  delete <name> [--force]         delete secret (30-day recovery by default, --force for immediate)
  restore <name>                  restore a deleted secret

create/update options:
  --string <value>                plain text secret value
  --json <value>                  JSON secret value
  --file <path>                   read secret from file
  --description <text>            secret description (create only)

examples:
  awst secrets ls
  awst secrets ls --csv
  awst secrets show my-secret
  awst secrets get my-secret
  awst secrets get my-db-creds --json
  awst secrets get my-db-creds --field password
  awst secrets get my-secret --version abc-123
  awst secrets create my-api-key --string "abc123xyz"
  awst secrets create my-db-creds --json '{"username":"admin","password":"pass123"}'
  awst secrets create my-cert --file cert.pem --description "SSL certificate"
  awst secrets update my-api-key --string "new-value"
  awst secrets delete my-old-secret
  awst secrets delete my-old-secret --force
  awst secrets restore my-secret
EOF
}

secrets_ls() {
  local fmt="${1:-table}"
  if [[ "$fmt" == "--csv" ]]; then
    echo "Name,Arn,LastChangedDate,LastAccessedDate,Description"
    aws secretsmanager list-secrets --query 'SecretList[].[Name,ARN,LastChangedDate,LastAccessedDate,Description]' --output text | sed 's/\t/,/g'
  else
    aws secretsmanager list-secrets --output json | jq -r '
      (["Name", "LastChanged", "Description"] | @tsv),
      (.SecretList[]
        | [
            .Name,
            (.LastChangedDate // "-"),
            (.Description // "-")
          ]
        | @tsv)
    ' | column -t -s $'\t'
  fi
}

secrets_show() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "Usage: awst secrets show <name>" >&2
    exit 1
  fi

  aws secretsmanager describe-secret --secret-id "$name" --output json | jq -r '
    "Name: \(.Name)",
    "ARN: \(.ARN)",
    "Description: \(.Description // "-")",
    "Created: \(.CreatedDate)",
    "LastChanged: \(.LastChangedDate // "-")",
    "LastAccessed: \(.LastAccessedDate // "-")",
    "RotationEnabled: \(.RotationEnabled // false)",
    (if .RotationEnabled then "RotationLambdaARN: \(.RotationLambdaARN // "-")" else empty end),
    (if .RotationEnabled then "RotationRules: \(.RotationRules.AutomaticallyAfterDays // "-") days" else empty end),
    "DeletedDate: \(.DeletedDate // "-")",
    "",
    "Tags:",
    (if .Tags then (.Tags[] | "  \(.Key): \(.Value)") else "  (none)" end)
  '
}

secrets_get() {
  local name=""
  local fmt="plain"
  local version=""
  local field=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        fmt="json"
        shift
        ;;
      --binary)
        fmt="binary"
        shift
        ;;
      --version)
        version="$2"
        shift 2
        ;;
      --field)
        field="$2"
        shift 2
        ;;
      *)
        if [[ -z "$name" ]]; then
          name="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$name" ]]; then
    echo "Usage: awst secrets get <name> [--json] [--field KEY] [--version ID]" >&2
    exit 1
  fi

  local args=(--secret-id "$name")
  if [[ -n "$version" ]]; then
    args+=(--version-id "$version")
  fi

  local response
  response="$(aws secretsmanager get-secret-value "${args[@]}" --output json)"

  local has_binary
  has_binary="$(echo "$response" | jq -r 'has("SecretBinary")')"

  if [[ "$has_binary" == "true" ]]; then
    if [[ "$fmt" == "binary" || "$fmt" == "plain" ]]; then
      echo "$response" | jq -r '.SecretBinary' | base64 -d
    else
      echo "Error: --json/--field not supported for binary secrets" >&2
      exit 1
    fi
    return 0
  fi

  local secret_string
  secret_string="$(echo "$response" | jq -r '.SecretString')"

  if [[ -n "$field" ]]; then
    echo "$secret_string" | jq -r --arg field "$field" '
      (try fromjson catch .) |
      if type == "object" then .[$field] // empty
      else empty end
    '
    return 0
  fi

  if [[ "$fmt" == "json" ]]; then
    echo "$secret_string" | jq 'try fromjson catch .'
    return 0
  fi

  printf '%s\n' "$secret_string"
}

secrets_create() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "Usage: awst secrets create <name> <options>" >&2
    echo "Options: --string <value> | --json <value> | --file <path> [--description <text>]" >&2
    exit 1
  fi
  shift

  local secret_value=""
  local description=""
  local value_type=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --string)
        secret_value="$2"
        value_type="string"
        shift 2
        ;;
      --json)
        secret_value="$2"
        value_type="json"
        shift 2
        ;;
      --file)
        if [[ ! -f "$2" ]]; then
          echo "Error: File not found: $2" >&2
          exit 1
        fi
        secret_value="$(cat "$2")"
        value_type="string"
        shift 2
        ;;
      --description)
        description="$2"
        shift 2
        ;;
      *)
        echo "Unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  if [[ -z "$secret_value" ]]; then
    echo "Error: No secret value provided" >&2
    exit 1
  fi

  local cmd="aws secretsmanager create-secret --name \"$name\" --secret-string"

  if [[ "$value_type" == "json" ]]; then
    cmd="$cmd $(printf '%q' "$secret_value")"
  else
    cmd="$cmd $(printf '%q' "$secret_value")"
  fi

  if [[ -n "$description" ]]; then
    cmd="$cmd --description $(printf '%q' "$description")"
  fi

  eval "$cmd" | jq -r '"Created: \(.Name)", "ARN: \(.ARN)", "VersionId: \(.VersionId)"'
}

secrets_update() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then
    echo "Usage: awst secrets update <name> <options>" >&2
    echo "Options: --string <value> | --json <value> | --file <path>" >&2
    exit 1
  fi
  shift

  local secret_value=""
  local value_type=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --string)
        secret_value="$2"
        value_type="string"
        shift 2
        ;;
      --json)
        secret_value="$2"
        value_type="json"
        shift 2
        ;;
      --file)
        if [[ ! -f "$2" ]]; then
          echo "Error: File not found: $2" >&2
          exit 1
        fi
        secret_value="$(cat "$2")"
        value_type="string"
        shift 2
        ;;
      *)
        echo "Unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  if [[ -z "$secret_value" ]]; then
    echo "Error: No secret value provided" >&2
    exit 1
  fi

  aws secretsmanager update-secret --secret-id "$name" --secret-string "$secret_value" | jq -r '"Updated: \(.Name)", "ARN: \(.ARN)", "VersionId: \(.VersionId)"'
}

secrets_delete() {
  local name="${1:-}"
  local force="${2:-}"

  if [[ -z "$name" ]]; then
    echo "Usage: awst secrets delete <name> [--force]" >&2
    exit 1
  fi

  if [[ "$force" == "--force" ]]; then
    echo "aws secretsmanager delete-secret --secret-id \"$name\" --force-delete-without-recovery"
    echo "# ^ Run the above command to permanently delete the secret (irreversible)"
  else
    echo "aws secretsmanager delete-secret --secret-id \"$name\""
    echo "# ^ Run the above command to delete the secret (30-day recovery window)"
    echo "#   To delete immediately, use: awst secrets delete $name --force"
  fi
}

secrets_restore() {
  local name="${1:-}"

  if [[ -z "$name" ]]; then
    echo "Usage: awst secrets restore <name>" >&2
    exit 1
  fi

  aws secretsmanager restore-secret --secret-id "$name" | jq -r '"Restored: \(.Name)", "ARN: \(.ARN)"'
}

case "$sub" in
  ls|list)
    secrets_ls "$@"
    ;;
  show|describe)
    secrets_show "$@"
    ;;
  get|value)
    secrets_get "$@"
    ;;
  create)
    secrets_create "$@"
    ;;
  update)
    secrets_update "$@"
    ;;
  delete|rm)
    secrets_delete "$@"
    ;;
  restore)
    secrets_restore "$@"
    ;;
  help|--help|-h|"")
    usage
    ;;
  *)
    echo "unknown secrets command: $sub" >&2
    usage >&2
    exit 1
    ;;
esac
