#!/usr/bin/env bash
set -e

cmd=$1
shift

ec2_get_id () {
local name=$1
aws ec2 describe-instances --filters "Name=tag:Name,Values=$name" --query "Reservations[].Instances[].InstanceId" --output text
}

ec2_ls_csv  () {
    query='Reservations[].Instances[].[(Tags[?Key==`Name`].Value)[0] || `""`,
          InstanceId,
          State.Name,
          InstanceType,
          PrivateIpAddress,
          PublicIpAddress,
          SubnetId,
          BlockDeviceMappings[0].Ebs.VolumeId,
	  join(`;`, SecurityGroups[*].GroupId)
        ]'
    echo "Name,InstanceId,State,InstanceType,PrivateIpAddress,PublicIpAddress,SubnetId,VolumeId,SecurityGroupIds"
    aws ec2 describe-instances --query "$query" --output text | tr '\t' ','
}

ec2_show() {
  local instance_id="${1:-}"
  if [[ -z "$instance_id" ]]; then
    echo "usage: awst ec2 show <instance-id>" >&2
    exit 1
  fi

  local json
  json="$(aws ec2 describe-instances --instance-ids "$instance_id" --output json)"

  echo "$json" | jq -r '
    .Reservations[0].Instances[0] |
    "Name: \(([.Tags[]? | select(.Key == "Name") | .Value][0]) // "-")",
    "InstanceId: \(.InstanceId)",
    "State: \(.State.Name)",
    "InstanceType: \(.InstanceType)",
    "ImageId: \(.ImageId)",
    "Architecture: \(.Architecture)",
    "Platform: \(.PlatformDetails // .Platform // "-")",
    "AvailabilityZone: \(.Placement.AvailabilityZone)",
    "VpcId: \(.VpcId // "-")",
    "SubnetId: \(.SubnetId // "-")",
    "PrivateIpAddress: \(.PrivateIpAddress // "-")",
    "PublicIpAddress: \(.PublicIpAddress // "-")",
    "PrivateDnsName: \(.PrivateDnsName // "-")",
    "PublicDnsName: \(.PublicDnsName // "-")",
    "KeyName: \(.KeyName // "-")",
    "IamInstanceProfile: \(.IamInstanceProfile.Arn // "-")",
    "LaunchTime: \(.LaunchTime)",
    "SecurityGroups: \((.SecurityGroups // []) | map("\(.GroupName)(\(.GroupId))") | if length > 0 then join(", ") else "-" end)",
    "Volumes:",
    ((.BlockDeviceMappings // [])[] | "  \(.DeviceName): \(.Ebs.VolumeId)"),
    "Tags:",
    ((.Tags // []) | sort_by(.Key)[] | "  \(.Key)=\(.Value)")
  '
}

ec2_types_csv() {
  local -a types=()
  local -a aws_args=()
  local arch=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --csv) shift ;;
      --x86_64)
        arch="x86_64"
        shift
        ;;
      --arm64)
        arch="arm64"
        shift
        ;;
      *) types+=("$1"); shift ;;
    esac
  done

  if [[ -n "$arch" ]]; then
    aws_args+=(--filters "Name=processor-info.supported-architecture,Values=$arch")
  fi
  if [[ ${#types[@]} -gt 0 ]]; then
    aws_args+=(--instance-types "${types[@]}")
  fi

  echo "InstanceType,Family,vCPU,MemoryGiB,Network,Arch,CurrentGen,BareMetal"
  aws ec2 describe-instance-types "${aws_args[@]}" --output json | jq -r --arg arch "$arch" '
    [.InstanceTypes[]
      | select($arch == "" or ((.ProcessorInfo.SupportedArchitectures // []) | index($arch) != null))
      | {
          InstanceType,
          Family: (.InstanceType | split(".")[0]),
          vCPU: .VCpuInfo.DefaultVCpus,
          MemoryGiB: ((.MemoryInfo.SizeInMiB // 0) / 1024),
          Network: (.NetworkInfo.NetworkPerformance // "-"),
          Arch: ((.ProcessorInfo.SupportedArchitectures // []) | join(";")),
          CurrentGen: .CurrentGeneration,
          BareMetal
        }
    ]
    | sort_by(.Family, .vCPU, .MemoryGiB)
    | .[]
    | [.InstanceType, .Family, .vCPU, .MemoryGiB, .Network, .Arch, .CurrentGen, .BareMetal]
    | @tsv
  ' | tr '\t' ','
}

lt_resolve() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "usage: awst ec2 lt <command> ..." >&2
    return 1
  fi
  if [[ "$name" =~ ^lt-[0-9a-f]+$ ]]; then
    printf '%s' "$name"
    return 0
  fi
  local id
  id="$(aws ec2 describe-launch-templates --launch-template-names "$name" \
    --query 'LaunchTemplates[0].LaunchTemplateId' --output text 2>/dev/null || true)"
  if [[ -n "$id" && "$id" != "None" ]]; then
    printf '%s' "$name"
    return 0
  fi
  echo "Launch template not found: $name" >&2
  return 1
}

lt_api_args() {
  local resolved="$1"
  if [[ "$resolved" =~ ^lt-[0-9a-f]+$ ]]; then
  printf '%s' "--launch-template-id $resolved"
  else
  printf '%s' "--launch-template-name $resolved"
  fi
}

lt_ls_csv() {
  echo "Name,LaunchTemplateId,LatestVersion,DefaultVersion,CreatedBy,CreateTime"
  aws ec2 describe-launch-templates \
    --query 'LaunchTemplates[].[LaunchTemplateName,LaunchTemplateId,LatestVersionNumber,DefaultVersionNumber,CreatedBy,CreateTime]' \
    --output text | tr '\t' ','
}

lt_versions_csv() {
  local name="$1"
  local resolved
  resolved="$(lt_resolve "$name")" || return 1
  local api_args
  api_args="$(lt_api_args "$resolved")"
  echo "Version,DefaultVersion,CreateTime,CreatedBy,ImageId,InstanceType,KeyName"
  # shellcheck disable=SC2086
  aws ec2 describe-launch-template-versions $api_args \
    --query 'LaunchTemplateVersions[].[VersionNumber,DefaultVersion,CreateTime,CreatedBy,LaunchTemplateData.ImageId,LaunchTemplateData.InstanceType,LaunchTemplateData.KeyName]' \
    --output text | tr '\t' ','
}

lt_show() {
  local name=""
  local version=""
  local fmt="table"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version)
        version="$2"
        shift 2
        ;;
      --json)
        fmt="json"
        shift
        ;;
      *)
        if [[ -z "$name" ]]; then
          name="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$name" ]]; then
    echo "usage: awst ec2 lt show NAME [--version N] [--json]" >&2
    exit 1
  fi

  local resolved
  resolved="$(lt_resolve "$name")" || exit 1
  local api_args
  api_args="$(lt_api_args "$resolved")"

  local meta_json
  if [[ "$resolved" =~ ^lt-[0-9a-f]+$ ]]; then
    meta_json="$(aws ec2 describe-launch-templates --launch-template-ids "$resolved" --output json)"
  else
    meta_json="$(aws ec2 describe-launch-templates --launch-template-names "$resolved" --output json)"
  fi

  local version_json
  if [[ -n "$version" ]]; then
    # shellcheck disable=SC2086
    version_json="$(aws ec2 describe-launch-template-versions $api_args --versions "$version" --output json)"
  else
    # shellcheck disable=SC2086
    version_json="$(aws ec2 describe-launch-template-versions $api_args --versions '$Latest' --output json)"
  fi

  if [[ "$fmt" == "json" ]]; then
    jq -n --argjson meta "$meta_json" --argjson versions "$version_json" \
      '{LaunchTemplate: $meta.LaunchTemplates[0], Versions: $versions.LaunchTemplateVersions}'
    return 0
  fi

  echo "$meta_json" | jq -r '
    .LaunchTemplates[0] |
    "Name: \(.LaunchTemplateName)",
    "LaunchTemplateId: \(.LaunchTemplateId)",
    "LatestVersion: \(.LatestVersionNumber)",
    "DefaultVersion: \(.DefaultVersionNumber)",
    "CreatedBy: \(.CreatedBy)",
    "CreateTime: \(.CreateTime)"
  '

  echo "$version_json" | jq -r '
    .LaunchTemplateVersions[] |
    "",
    "=== Version \(.VersionNumber)\(if .DefaultVersion then " (default)" else "" end) ===",
    "CreateTime: \(.CreateTime)",
    "CreatedBy: \(.CreatedBy // "-")",
    "ImageId: \(.LaunchTemplateData.ImageId // "-")",
    "InstanceType: \(.LaunchTemplateData.InstanceType // "-")",
    "KeyName: \(.LaunchTemplateData.KeyName // "-")",
    "IamInstanceProfile: \(.LaunchTemplateData.IamInstanceProfile.Arn // .LaunchTemplateData.IamInstanceProfile.Name // "-")",
    "SecurityGroupIds: \(
      (
        (.LaunchTemplateData.SecurityGroupIds // [])
        + ((.LaunchTemplateData.SecurityGroups // []) | map(.GroupId))
        + ([.LaunchTemplateData.NetworkInterfaces[]?.Groups[]?])
      ) | unique | if length > 0 then join(", ") else "-" end
    )",
    (if (.LaunchTemplateData.SecurityGroups // [] | length) > 0 then
      "SecurityGroups: \((.LaunchTemplateData.SecurityGroups // []) | map("\(.GroupId)(\(.GroupName // "-"))") | join(", "))"
    else empty end),
    "SubnetId: \(.LaunchTemplateData.NetworkInterfaces[0].SubnetId // .LaunchTemplateData.SubnetId // "-")",
    "VpcId: \(.LaunchTemplateData.NetworkInterfaces[0].VpcId // "-")",
    "AssociatePublicIp: \(.LaunchTemplateData.NetworkInterfaces[0].AssociatePublicIpAddress // "-")",
  (if (.LaunchTemplateData.NetworkInterfaces // [] | length) > 0 then
    "NetworkInterfaces:",
    (.LaunchTemplateData.NetworkInterfaces[] |
      "  [device \(.DeviceIndex)] Groups: \((.Groups // []) | if length > 0 then join(", ") else "-" end), Subnet: \(.SubnetId // "-"), PublicIP: \(.AssociatePublicIpAddress // "-")")
  else empty end),
    "EbsOptimized: \(.LaunchTemplateData.EbsOptimized // "-")",
  (if (.LaunchTemplateData.BlockDeviceMappings // [] | length) > 0 then
    "BlockDeviceMappings:",
    (.LaunchTemplateData.BlockDeviceMappings[] |
      "  \(.DeviceName): \(.Ebs.VolumeSize // "-")GB \(.Ebs.VolumeType // "-") \(.Ebs.Encrypted // false | if . then "encrypted" else "unencrypted" end)")
  else empty end),
  (if .LaunchTemplateData.UserData then
    "UserData:",
    (.LaunchTemplateData.UserData | @base64d | split("\n")[] | "  " + .)
  else
    "UserData: -"
  end),
  (if (.LaunchTemplateData.TagSpecifications // [] | length) > 0 then
    "TagSpecifications:",
    (.LaunchTemplateData.TagSpecifications[] |
      "  \(.ResourceType): " + ((.Tags // []) | map("\(.Key)=\(.Value)") | join(", ")))
  else empty end)
  '
}


case "$cmd" in
  ls)
    if [[ "$1" == "--csv" ]]; then
      ec2_ls_csv
    else
      ec2_ls_csv | column -s, -t
    fi
  ;;
  show)
    ec2_show "$@"
  ;;
  types)
    if [[ " $* " == *" --csv "* ]]; then
      ec2_types_csv "$@"
    else
      ec2_types_csv "$@" | column -s, -t
    fi
  ;;
  start)
    id=$(ec2_get_id "$1")
    if [[ -n "$DEBUG" ]]; then
      echo "aws ec2 start-instances --instance-ids $id"
    else
      aws ec2 start-instances --instance-ids $id
    fi
  ;;
  stop)
    id=$(ec2_get_id "$1")
    if [[ -n "$DEBUG" ]]; then
      echo "aws ec2 stop-instances --instance-ids $id"
    else
      echo "aws ec2 stop-instances --instance-ids $id"
      echo "# Run the above command to stop the instance"
    fi
  ;;

  sg_rules)
   COLS="GroupId,GroupName,Direction,Proto,Port,CidrIp,GroupId,Description"
   echo $COLS
   for x in `aws ec2 describe-security-groups --query 'SecurityGroups[].GroupId' | jq -r '.[] | @text' `; do
      aws ec2 describe-security-groups  --group-ids $x --query 'SecurityGroups[]' | jq -r '
  .[] |
  .GroupId as $gid |
  .GroupName as $name |
  ( [.IpPermissions[] + {"Direction": "Ingress"}] + [.IpPermissionsEgress[] + {"Direction": "Egress"}]) [] |
  .Direction as $direction |
  .IpProtocol as $proto |
  .ToPort as $port |
  ([.IpRanges[]] + [.UserIdGroupPairs[]])[] |
  [
    $gid,
    $name,
    $direction,
    $proto,
    $port,
    .CidrIp,
    .GroupId,
    .Description
  ] | @csv
'
   done
  ;;

  lt)
    lt_cmd=$1
    shift || true
    case "$lt_cmd" in
      ls)
        if [[ "$1" == "--csv" ]]; then
          lt_ls_csv
        else
          lt_ls_csv | column -s, -t
        fi
        ;;
      show)
        lt_show "$@"
        ;;
      versions)
        if [[ "$1" == "--csv" ]]; then
          shift || true
          lt_versions_csv "$@"
        else
          lt_versions_csv "$@" | column -s, -t
        fi
        ;;
      *)
        echo "launch template commands:"
        echo "  lt ls [--csv]              list launch templates"
        echo "  lt show NAME [--version N] [--json]  show launch template details"
        echo "  lt versions NAME [--csv]   list all versions"
        ;;
    esac
  ;;

  *)
    echo "ec2 commands:"
    echo "  ls         list instances"
    echo "  ls --csv   list instances as csv"
    echo "  show INSTANCE_ID"
    echo "  types [TYPE...] [--x86_64|--arm64] [--csv]  list instance types"
    echo "  ssh NAME"
    echo "  start NAME"
    echo "  stop NAME"
    echo "  sg_rules"
    echo "  lt         launch template commands (lt ls, lt show, lt versions)"
  ;;
esac
