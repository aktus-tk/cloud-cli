#!/usr/bin/env bash
set -e

cmd=$1
shift

ec2_get_id () {
local name=$1
aws ec2 describe-instances --filters "Name=tag:Name,Values=$name" --query "Reservations[].Instances[].InstanceId" --output text
}

ec2_ls_csv  () {
    query='Reservations[].Instances[].[(Tags[?Key==`Name`].Value)[0] || `""`,
          InstanceId,
          State.Name,
          InstanceType,
          PrivateIpAddress,
          PublicIpAddress,
          SubnetId,
          BlockDeviceMappings[0].Ebs.VolumeId,
	  join(`;`, SecurityGroups[*].GroupId)
        ]'
    echo "Name,InstanceId,State,InstanceType,PrivateIpAddress,PublicIpAddress,SubnetId,VolumeId,SecurityGroupIds"
    aws ec2 describe-instances --query "$query" --output text | tr '\t' ','
}

ec2_show() {
  local instance_id="${1:-}"
  if [[ -z "$instance_id" ]]; then
    echo "usage: awst ec2 show <instance-id>" >&2
    exit 1
  fi

  local -a describe_cmd=(ec2 describe-instances --instance-ids "$instance_id" --output json)
  local -a userdata_cmd=(ec2 describe-instance-attribute --instance-id "$instance_id" --attribute userData --query UserData.Value --output text)

  if [[ -n "${CLOUD_CLI_DEBUG:-}" ]]; then
    printf '%q ' aws "${describe_cmd[@]}"; echo
    printf '%q ' aws "${userdata_cmd[@]}"; echo
    exit 0
  fi

  local json
  json="$(aws "${describe_cmd[@]}")"

  echo "$json" | jq -r '
    .Reservations[0].Instances[0] |
    "Name: \(([.Tags[]? | select(.Key == "Name") | .Value][0]) // "-")",
    "InstanceId: \(.InstanceId)",
    "State: \(.State.Name)",
    "InstanceType: \(.InstanceType)",
    "ImageId: \(.ImageId)",
    "Architecture: \(.Architecture)",
    "Platform: \(.PlatformDetails // .Platform // "-")",
    "AvailabilityZone: \(.Placement.AvailabilityZone)",
    "VpcId: \(.VpcId // "-")",
    "SubnetId: \(.SubnetId // "-")",
    "PrivateIpAddress: \(.PrivateIpAddress // "-")",
    "PublicIpAddress: \(.PublicIpAddress // "-")",
    "PrivateDnsName: \(.PrivateDnsName // "-")",
    "PublicDnsName: \(.PublicDnsName // "-")",
    "KeyName: \(.KeyName // "-")",
    "IamInstanceProfile: \(.IamInstanceProfile.Arn // "-")",
    "LaunchTime: \(.LaunchTime)",
    "SecurityGroups: \((.SecurityGroups // []) | map("\(.GroupName)(\(.GroupId))") | if length > 0 then join(", ") else "-" end)",
    "Volumes:",
    ((.BlockDeviceMappings // [])[] | "  \(.DeviceName): \(.Ebs.VolumeId)"),
    "Tags:",
    ((.Tags // []) | sort_by(.Key)[] | "  \(.Key)=\(.Value)")
  '

  local user_data
  user_data="$(aws "${userdata_cmd[@]}" 2>/dev/null || true)"
  if [[ -z "$user_data" || "$user_data" == "None" ]]; then
    echo "UserData: -"
    return 0
  fi

  local decoded
  if decoded="$(printf '%s' "$user_data" | base64 -d 2>/dev/null)"; then
    echo "UserData:"
    printf '%s\n' "$decoded" | sed 's/^/  /'
  else
    echo "UserData: (base64 decode failed)"
  fi
}

ec2_types_csv() {
  local -a types=()
  local -a aws_args=()
  local arch=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --csv) shift ;;
      --x86_64)
        arch="x86_64"
        shift
        ;;
      --arm64)
        arch="arm64"
        shift
        ;;
      *) types+=("$1"); shift ;;
    esac
  done

  if [[ -n "$arch" ]]; then
    aws_args+=(--filters "Name=processor-info.supported-architecture,Values=$arch")
  fi
  if [[ ${#types[@]} -gt 0 ]]; then
    aws_args+=(--instance-types "${types[@]}")
  fi

  echo "InstanceType,Family,vCPU,MemoryGiB,Network,Arch,CurrentGen,BareMetal"
  aws ec2 describe-instance-types "${aws_args[@]}" --output json | jq -r --arg arch "$arch" '
    [.InstanceTypes[]
      | select($arch == "" or ((.ProcessorInfo.SupportedArchitectures // []) | index($arch) != null))
      | {
          InstanceType,
          Family: (.InstanceType | split(".")[0]),
          vCPU: .VCpuInfo.DefaultVCpus,
          MemoryGiB: ((.MemoryInfo.SizeInMiB // 0) / 1024),
          Network: (.NetworkInfo.NetworkPerformance // "-"),
          Arch: ((.ProcessorInfo.SupportedArchitectures // []) | join(";")),
          CurrentGen: .CurrentGeneration,
          BareMetal
        }
    ]
    | sort_by(.Family, .vCPU, .MemoryGiB)
    | .[]
    | [.InstanceType, .Family, .vCPU, .MemoryGiB, .Network, .Arch, .CurrentGen, .BareMetal]
    | @tsv
  ' | tr '\t' ','
}

lt_resolve() {
  local name="$1"
  if [[ -z "$name" ]]; then
    echo "usage: awst ec2 launch-template <command> ..." >&2
    return 1
  fi
  if [[ "$name" =~ ^lt-[0-9a-f]+$ ]]; then
    printf '%s' "$name"
    return 0
  fi
  local id
  id="$(aws ec2 describe-launch-templates --launch-template-names "$name" \
    --query 'LaunchTemplates[0].LaunchTemplateId' --output text 2>/dev/null || true)"
  if [[ -n "$id" && "$id" != "None" ]]; then
    printf '%s' "$name"
    return 0
  fi
  echo "Launch template not found: $name" >&2
  return 1
}

lt_api_args() {
  local resolved="$1"
  if [[ "$resolved" =~ ^lt-[0-9a-f]+$ ]]; then
  printf '%s' "--launch-template-id $resolved"
  else
  printf '%s' "--launch-template-name $resolved"
  fi
}

lt_ls_csv() {
  echo "Name,LaunchTemplateId,LatestVersion,DefaultVersion,CreatedBy,CreateTime"
  aws ec2 describe-launch-templates \
    --query 'LaunchTemplates[].[LaunchTemplateName,LaunchTemplateId,LatestVersionNumber,DefaultVersionNumber,CreatedBy,CreateTime]' \
    --output text | tr '\t' ','
}

lt_versions_csv() {
  local name="$1"
  local resolved
  resolved="$(lt_resolve "$name")" || return 1
  local api_args
  api_args="$(lt_api_args "$resolved")"
  echo "Version,DefaultVersion,CreateTime,CreatedBy,ImageId,InstanceType,KeyName"
  # shellcheck disable=SC2086
  aws ec2 describe-launch-template-versions $api_args \
    --query 'LaunchTemplateVersions[].[VersionNumber,DefaultVersion,CreateTime,CreatedBy,LaunchTemplateData.ImageId,LaunchTemplateData.InstanceType,LaunchTemplateData.KeyName]' \
    --output text | tr '\t' ','
}

lt_show() {
  local name=""
  local version=""
  local fmt="table"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version)
        version="${2:-}"
        shift 2
        ;;
      --json)
        fmt="json"
        shift
        ;;
      *)
        if [[ -z "$name" ]]; then
          name="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$name" ]]; then
    echo "usage: awst ec2 launch-template show <id|name> [--version N|latest|default] [--json]" >&2
    exit 1
  fi

  local vsel="$version"
  case "$vsel" in
    ""|latest) vsel='$Latest' ;;
    default) vsel='$Default' ;;
  esac

  local -a meta_cmd ver_cmd
  if [[ "$name" =~ ^lt-[0-9a-f]+$ ]]; then
    meta_cmd=(ec2 describe-launch-templates --launch-template-ids "$name" --output json)
    ver_cmd=(ec2 describe-launch-template-versions --launch-template-id "$name" --versions "$vsel" --output json)
  else
    meta_cmd=(ec2 describe-launch-templates --launch-template-names "$name" --output json)
    ver_cmd=(ec2 describe-launch-template-versions --launch-template-name "$name" --versions "$vsel" --output json)
  fi

  if [[ -n "${CLOUD_CLI_DEBUG:-}" ]]; then
    printf '%q ' aws "${meta_cmd[@]}"; echo
    printf '%q ' aws "${ver_cmd[@]}"; echo
    exit 0
  fi

  local meta_json
  meta_json="$(aws "${meta_cmd[@]}")"
  if [[ "$(echo "$meta_json" | jq '.LaunchTemplates | length')" == "0" ]]; then
    echo "Launch template not found: $name" >&2
    exit 1
  fi

  local version_json
  version_json="$(aws "${ver_cmd[@]}")"

  if [[ "$fmt" == "json" ]]; then
    jq -n --argjson meta "$meta_json" --argjson versions "$version_json" \
      '{LaunchTemplate: $meta.LaunchTemplates[0], Versions: $versions.LaunchTemplateVersions}'
    return 0
  fi

  echo "$meta_json" | jq -r '
    .LaunchTemplates[0] |
    "Name: \(.LaunchTemplateName)",
    "LaunchTemplateId: \(.LaunchTemplateId)",
    "LatestVersion: \(.LatestVersionNumber)",
    "DefaultVersion: \(.DefaultVersionNumber)",
    "CreatedBy: \(.CreatedBy)",
    "CreateTime: \(.CreateTime)"
  '

  echo "$version_json" | jq -r '
    .LaunchTemplateVersions[]? |
    "",
    "=== Version \(.VersionNumber)\(if .DefaultVersion then " (default)" else "" end) ===",
    "CreateTime: \(.CreateTime)",
    "CreatedBy: \(.CreatedBy // "-")",
    "ImageId: \(.LaunchTemplateData.ImageId // "-")",
    "InstanceType: \(.LaunchTemplateData.InstanceType // "-")",
    "KeyName: \(.LaunchTemplateData.KeyName // "-")",
    "IamInstanceProfile: \(.LaunchTemplateData.IamInstanceProfile.Arn // .LaunchTemplateData.IamInstanceProfile.Name // "-")",
    "SecurityGroups: \(
      (
        (.LaunchTemplateData.SecurityGroupIds // [])
        + (.LaunchTemplateData.SecurityGroups // [])
        + ([.LaunchTemplateData.NetworkInterfaces[]?.Groups[]?])
      ) | unique | if length > 0 then join(", ") else "-" end
    )",
    "SubnetId: \(.LaunchTemplateData.NetworkInterfaces[0].SubnetId // .LaunchTemplateData.SubnetId // "-")",
    "VpcId: \(.LaunchTemplateData.NetworkInterfaces[0].VpcId // "-")",
    "AssociatePublicIp: \(.LaunchTemplateData.NetworkInterfaces[0].AssociatePublicIpAddress // "-")",
  (if (.LaunchTemplateData.NetworkInterfaces // [] | length) > 0 then
    "NetworkInterfaces:",
    (.LaunchTemplateData.NetworkInterfaces[] |
      "  [device \(.DeviceIndex)] Groups: \((.Groups // []) | if length > 0 then join(", ") else "-" end), Subnet: \(.SubnetId // "-"), PublicIP: \(.AssociatePublicIpAddress // "-")")
  else empty end),
    "EbsOptimized: \(.LaunchTemplateData.EbsOptimized // "-")",
  (if (.LaunchTemplateData.BlockDeviceMappings // [] | length) > 0 then
    "BlockDeviceMappings:",
    (.LaunchTemplateData.BlockDeviceMappings[] |
      "  \(.DeviceName): \(.Ebs.VolumeSize // "-")GB \(.Ebs.VolumeType // "-") \(.Ebs.Encrypted // false | if . then "encrypted" else "unencrypted" end)")
  else "BlockDeviceMappings: -" end),
  (if .LaunchTemplateData.UserData then
    "UserData: present",
    (.LaunchTemplateData.UserData | @base64d | split("\n")[] | "  " + .)
  else
    "UserData: -"
  end),
    "MetadataOptions:",
    "  HttpTokens: \(.LaunchTemplateData.MetadataOptions.HttpTokens // "-")",
    "  HttpEndpoint: \(.LaunchTemplateData.MetadataOptions.HttpEndpoint // "-")",
    "  HttpPutResponseHopLimit: \(.LaunchTemplateData.MetadataOptions.HttpPutResponseHopLimit // "-")",
    "  InstanceMetadataTags: \(.LaunchTemplateData.MetadataOptions.InstanceMetadataTags // "-")",
  (if (.LaunchTemplateData.TagSpecifications // [] | length) > 0 then
    "TagSpecifications:",
    (.LaunchTemplateData.TagSpecifications[] |
      "  \(.ResourceType): " + ((.Tags // []) | map("\(.Key)=\(.Value)") | join(", ")))
  else empty end)
  '
}

ebs_ls_csv() {
  echo "VolumeId,SizeGiB,Type,State,AZ,CreateTime,Name,AttachedInstanceId"
  echo "$1" | jq -r '
    [.Volumes[] | {
      VolumeId,
      SizeGiB: .Size,
      Type: .VolumeType,
      State: .State,
      AZ: .AvailabilityZone,
      CreateTime,
      Name: (([.Tags[]? | select(.Key == "Name") | .Value][0]) // ""),
      AttachedInstanceId: (.Attachments[0].InstanceId // "")
    }]
    | sort_by(.VolumeId)
    | .[]
    | [.VolumeId, (.SizeGiB | tostring), .Type, .State, .AZ, .CreateTime, .Name, .AttachedInstanceId]
    | @tsv
  ' | tr '\t' ','
}

ebs_ls() {
  local state="all"
  local output="table"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --state)
        state="$2"
        shift 2
        ;;
      --csv)
        output="csv"
        shift
        ;;
      --json)
        output="json"
        shift
        ;;
      *)
        echo "unknown option: $1 (awst ec2 ebs help)" >&2
        exit 1
        ;;
    esac
  done

  case "$state" in
    all|available|in-use) ;;
    *)
      echo "--state must be available, in-use, or all: $state" >&2
      exit 1
      ;;
  esac

  local -a cmd=(ec2 describe-volumes --output json)
  if [[ "$state" != "all" ]]; then
    cmd+=(--filters "Name=status,Values=$state")
  fi

  if [[ -n "${CLOUD_CLI_DEBUG:-}" ]]; then
    printf '%q ' aws "${cmd[@]}"
    echo
    exit 0
  fi

  local json
  json="$(aws "${cmd[@]}")"

  case "$output" in
    json)
      echo "$json" | jq '
        [.Volumes[] | {
          VolumeId,
          SizeGiB: .Size,
          Type: .VolumeType,
          State: .State,
          AZ: .AvailabilityZone,
          CreateTime,
          Name: (([.Tags[]? | select(.Key == "Name") | .Value][0]) // ""),
          AttachedInstanceId: (.Attachments[0].InstanceId // "")
        }]
        | sort_by(.VolumeId)
      '
      ;;
    csv)
      ebs_ls_csv "$json"
      ;;
    table)
      ebs_ls_csv "$json" | column -s, -t
      ;;
  esac
}

ebs_show() {
  local volume_id=""
  local output="table"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        output="json"
        shift
        ;;
      *)
        if [[ -z "$volume_id" ]]; then
          volume_id="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$volume_id" ]]; then
    echo "usage: awst ec2 ebs show <volume-id> [--json]" >&2
    exit 1
  fi

  local -a cmd=(ec2 describe-volumes --volume-ids "$volume_id" --output json)

  if [[ -n "${CLOUD_CLI_DEBUG:-}" ]]; then
    printf '%q ' aws "${cmd[@]}"
    echo
    exit 0
  fi

  local json
  json="$(aws "${cmd[@]}")"

  if [[ "$output" == "json" ]]; then
    echo "$json" | jq '
      .Volumes[0] | {
        VolumeId,
        SizeGiB: .Size,
        Type: .VolumeType,
        State: .State,
        AZ: .AvailabilityZone,
        SnapshotId: (.SnapshotId // ""),
        CreateTime,
        Tags: (.Tags // []),
        Attachments: (.Attachments // [])
      }
    '
    return 0
  fi

  echo "$json" | jq -r '
    .Volumes[0] |
    "VolumeId: \(.VolumeId)",
    "State: \(.State)",
    "Size: \(.Size) GiB",
    "Type: \(.VolumeType)",
    "AvailabilityZone: \(.AvailabilityZone)",
    "SnapshotId: \(.SnapshotId // "-")",
    "CreateTime: \(.CreateTime)",
    "Tags:",
    (if (.Tags // [] | length) > 0 then
      ((.Tags // []) | sort_by(.Key)[] | "  \(.Key)=\(.Value)")
    else "  -" end),
    "Attachments:",
    (if (.Attachments // [] | length) > 0 then
      ((.Attachments // [])[] | "  \(.InstanceId // "-"): \(.Device // "-") state=\(.State // "-")")
    else "  -" end)
  '
}

ebs_summary_csv() {
  echo "Group,Key,Count,SizeGiB"
  echo "$1" | jq -r '
    def fmt:
      .[] | [.Group, (.Key // "-"), (.Count | tostring), (.SizeGiB | tostring)] | @tsv;
    (
      (.Volumes | group_by(.State)
        | map({Group: "State", Key: .[0].State, Count: length, SizeGiB: (map(.Size) | add)})),
      (.Volumes | group_by(.VolumeType)
        | map({Group: "VolumeType", Key: .[0].VolumeType, Count: length, SizeGiB: (map(.Size) | add)})),
      (.Volumes | group_by(.AvailabilityZone)
        | map({Group: "AZ", Key: .[0].AvailabilityZone, Count: length, SizeGiB: (map(.Size) | add)}))
    ) | fmt
  ' | tr '\t' ','
}

ebs_summary() {
  local output="table"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --csv)
        output="csv"
        shift
        ;;
      *)
        echo "unknown option: $1 (awst ec2 ebs help)" >&2
        exit 1
        ;;
    esac
  done

  local -a cmd=(ec2 describe-volumes --output json)

  if [[ -n "${CLOUD_CLI_DEBUG:-}" ]]; then
    printf '%q ' aws "${cmd[@]}"
    echo
    exit 0
  fi

  local json
  json="$(aws "${cmd[@]}")"

  case "$output" in
    csv)
      ebs_summary_csv "$json"
      ;;
    table)
      ebs_summary_csv "$json" | column -s, -t
      ;;
  esac
}


case "$cmd" in
  ls)
    if [[ "$1" == "--csv" ]]; then
      ec2_ls_csv
    else
      ec2_ls_csv | column -s, -t
    fi
  ;;
  show)
    ec2_show "$@"
  ;;
  types)
    if [[ " $* " == *" --csv "* ]]; then
      ec2_types_csv "$@"
    else
      ec2_types_csv "$@" | column -s, -t
    fi
  ;;
  start)
    id=$(ec2_get_id "$1")
    if [[ -n "$DEBUG" ]]; then
      echo "aws ec2 start-instances --instance-ids $id"
    else
      aws ec2 start-instances --instance-ids $id
    fi
  ;;
  stop)
    id=$(ec2_get_id "$1")
    if [[ -n "$DEBUG" ]]; then
      echo "aws ec2 stop-instances --instance-ids $id"
    else
      echo "aws ec2 stop-instances --instance-ids $id"
      echo "# Run the above command to stop the instance"
    fi
  ;;

  sg_rules)
   COLS="GroupId,GroupName,Direction,Proto,Port,CidrIp,GroupId,Description"
   echo $COLS
   for x in `aws ec2 describe-security-groups --query 'SecurityGroups[].GroupId' | jq -r '.[] | @text' `; do
      aws ec2 describe-security-groups  --group-ids $x --query 'SecurityGroups[]' | jq -r '
  .[] |
  .GroupId as $gid |
  .GroupName as $name |
  ( [.IpPermissions[] + {"Direction": "Ingress"}] + [.IpPermissionsEgress[] + {"Direction": "Egress"}]) [] |
  .Direction as $direction |
  .IpProtocol as $proto |
  .ToPort as $port |
  ([.IpRanges[]] + [.UserIdGroupPairs[]])[] |
  [
    $gid,
    $name,
    $direction,
    $proto,
    $port,
    .CidrIp,
    .GroupId,
    .Description
  ] | @csv
'
   done
  ;;

  lt|launch-template)
    lt_cmd=$1
    shift || true
    case "$lt_cmd" in
      ls)
        if [[ "$1" == "--csv" ]]; then
          lt_ls_csv
        else
          lt_ls_csv | column -s, -t
        fi
        ;;
      show)
        lt_show "$@"
        ;;
      versions)
        csv=0
        vargs=()
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --csv) csv=1; shift ;;
            *) vargs+=("$1"); shift ;;
          esac
        done
        if [[ "$csv" -eq 1 ]]; then
          lt_versions_csv "${vargs[@]}"
        else
          lt_versions_csv "${vargs[@]}" | column -s, -t
        fi
        ;;
      *)
        echo "launch template commands (launch-template / lt):"
        echo "  launch-template ls [--csv]              起動テンプレート一覧を表示"
        echo "  launch-template show NAME [--version N|latest|default] [--json]  起動テンプレートの詳細を表示"
        echo "  launch-template versions NAME [--csv]   全バージョン一覧を表示"
        ;;
    esac
  ;;

  ebs)
    ebs_cmd=$1
    shift || true
    case "$ebs_cmd" in
      ls)
        ebs_ls "$@"
        ;;
      show)
        ebs_show "$@"
        ;;
      summary)
        ebs_summary "$@"
        ;;
      *)
        echo "ebs commands:"
        echo "  ebs ls [--state available|in-use|all] [--csv] [--json]  EBS ボリューム一覧"
        echo "  ebs show <volume-id> [--json]                          ボリューム詳細"
        echo "  ebs summary [--csv]                                    State/Type/AZ 別の集計"
        ;;
    esac
  ;;

  *)
    echo "ec2 commands:"
    echo "  ls         インスタンス一覧"
    echo "  ls --csv   インスタンス一覧（CSV）"
    echo "  show INSTANCE_ID"
    echo "  types [TYPE...] [--x86_64|--arm64] [--csv]  インスタンスタイプ一覧"
    echo "  ssh NAME"
    echo "  start NAME"
    echo "  stop NAME"
    echo "  sg_rules"
    echo "  launch-template  起動テンプレート関連を表示（launch-template ls / show / versions、lt は alias）"
    echo "  ebs        EBS ボリューム関連（ebs ls / ebs show / ebs summary）"
  ;;
esac
