#!/usr/bin/env bash

if [[ -L "$0" ]]; then
  _bin="$(dirname "$(readlink -f "$0")")"
else
  _bin="$(dirname "$0")"
fi

_debug=0
_region=""
_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --debug)
      _debug=1
      shift
      ;;
    --region)
      [[ -n "${2:-}" ]] || { echo "awst: --region requires a value" >&2; exit 1; }
      _region="$2"
      shift 2
      ;;
    --region=*)
      _region="${1#--region=}"
      [[ -n "$_region" ]] || { echo "awst: --region requires a value" >&2; exit 1; }
      shift
      ;;
    *)
      _args+=("$1")
      shift
      ;;
  esac
done
set -- "${_args[@]}"

if [[ -n "$_region" ]]; then
  export AWS_REGION="$_region"
  export AWS_DEFAULT_REGION="$_region"
fi

COMMANDS="${_bin}/../commands"
CMD="$1"

if [[ -z "$CMD" ]]; then
  echo "usage: awst [--debug] [--region <name>] <command> ..."
  echo
  echo "global options:"
  echo "  --debug              print resolved aws CLI invocations"
  echo "  --region <name>      set AWS region for this invocation (anywhere in args)"
  echo
  echo "available commands:"
  ls "$COMMANDS"
  exit 1
fi

shift

if [[ "$_debug" -eq 1 ]]; then
  export CLOUD_CLI_DEBUG=1
  if ! _real="$(command -v aws)"; then
    echo "awst: aws not found on PATH (--debug needs resolved aws)" >&2
    exit 1
  fi
  export CLOUD_CLI_REAL_AWS="$_real"
  export PATH="${_bin}/_shims:${PATH}"
fi

COMMAND="$COMMANDS/$CMD"

if [[ ! -x "$COMMAND" ]]; then
  echo "unknown command: $CMD"
  exit 1
fi

# 引数なしなら help
if [[ $# -eq 0 ]]; then
  exec "$COMMAND" help
else
  exec "$COMMAND" "$@"
fi
