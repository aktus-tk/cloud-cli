#!/usr/bin/env bash
set -e

cmd=$1
shift || true

case "$cmd" in
  ls|list)
    exec gcl network list "$@"
    ;;
  routes|route)
    exec gcl network routes "$@"
    ;;
  routers|router)
    exec gcl network routers "$@"
    ;;
  # 未実装: aktus-tk/gcp で subnets / nat を追加する
  subnets|subnet|nat)
    echo "gcl: network $cmd is not implemented yet." >&2
    echo "  add it in aktus-tk/gcp (cmd/network.go, internal/compute)" >&2
    exit 2
    ;;
  help|-h|--help|"")
    echo "network commands (gcloud-lite backend):"
    echo "  ls               VPC ネットワーク一覧"
    echo "  routes           ルート一覧"
    echo "  routers          Cloud Router（と NAT）一覧"
    echo ""
    echo "not implemented in gcl (see aktus-tk/gcp):"
    echo "  subnets / nat"
    ;;
  *)
    echo "unknown command: $cmd" >&2
    echo "run: gcl network help" >&2
    exit 1
    ;;
esac
