#!/usr/bin/env bash
set -euo pipefail
_shim_dir="$(dirname "$(readlink -f "$0")")"
# shellcheck source=../_lib/assume.sh
source "${_shim_dir}/../_lib/assume.sh"
real="${CLOUD_CLI_REAL_TCCLI:?CLOUD_CLI_REAL_TCCLI not set}"
args=("$@")

tccli_args_have_region() {
  local a
  for a in "$@"; do
    case "$a" in
      --region|--region=*) return 0 ;;
    esac
  done
  return 1
}

# tc-assume 経由 (TC_ASSUME_WRAPPED=1) では環境変数の一時認証を使う。
# それ以外で tc-assume 未管理プロファイルのみ --profile を注入（~/.tccli/*.credential 用）。
if [[ -z "${TC_ASSUME_WRAPPED:-}" && -n "${TENCENTCLOUD_PROFILE:-}" ]] \
  && ! tc_assume_has_profile "${TENCENTCLOUD_PROFILE}"; then
  args=(--profile "$TENCENTCLOUD_PROFILE" "${args[@]}")
fi
# tcclit --region（CLOUD_CLI_TCCLI_REGION）を優先。未指定時のみ TENCENTCLOUD_REGION（プロファイル等）。
_tc_region="${CLOUD_CLI_TCCLI_REGION:-${TENCENTCLOUD_REGION:-}}"
if [[ -n "$_tc_region" ]] && ! tccli_args_have_region "${args[@]}"; then
  args=(--region "$_tc_region" "${args[@]}")
fi
if [[ -n "${CLOUD_CLI_DEBUG:-}" ]]; then
  printf 'debug:' >&2
  printf ' %q' "$real" "${args[@]}" >&2
  printf '\n' >&2
fi
exec "$real" "${args[@]}"