#!/usr/bin/env bash

if [[ -L "$0" ]]; then
  _bin="$(dirname "$(readlink -f "$0")")"
else
  _bin="$(dirname "$0")"
fi

_debug=0
_args=()
for _a in "$@"; do
  if [[ "$_a" == "--debug" ]]; then _debug=1
  else _args+=("$_a")
  fi
done
set -- "${_args[@]}"

COMMANDS="${_bin}/../commands"
CMD="$1"

if [[ -z "$CMD" ]]; then
  echo "usage: tcclit [--debug] <command> ..."
  echo
  echo "available commands:"
  ls "$COMMANDS"
  exit 1
fi

shift

if [[ "$_debug" -eq 1 ]]; then
  export CLOUD_CLI_DEBUG=1
  if ! _real="$(command -v tccli)"; then
    echo "tcclit: tccli not found on PATH (--debug needs resolved tccli)" >&2
    exit 1
  fi
  export CLOUD_CLI_REAL_TCCLI="$_real"
  export PATH="${_bin}/_shims:${PATH}"
fi

COMMAND="$COMMANDS/$CMD"

if [[ ! -x "$COMMAND" ]]; then
  echo "unknown command: $CMD"
  exit 1
fi

# 引数なしなら help
if [[ $# -eq 0 ]]; then
  exec "$COMMAND" help
else
  exec "$COMMAND" "$@"
fi
