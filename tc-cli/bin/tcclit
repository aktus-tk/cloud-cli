#!/usr/bin/env bash

if [[ -L "$0" ]]; then
  _bin="$(dirname "$(readlink -f "$0")")"
else
  _bin="$(dirname "$0")"
fi

_debug=0
_args=()
for _a in "$@"; do
  if [[ "$_a" == "--debug" ]]; then _debug=1
  else _args+=("$_a")
  fi
done
set -- "${_args[@]}"

COMMANDS="${_bin}/../commands"
CMD="$1"

if [[ -z "$CMD" ]]; then
  echo "usage: tcclit [--debug] <command> ..."
  echo
  echo "available commands:"
  ls "$COMMANDS"
  exit 1
fi

shift

if [[ "$_debug" -eq 1 ]]; then
  export CLOUD_CLI_DEBUG=1
fi

# tccli を常に shim 経由にする (--profile 自動注入 / --debug 時のコマンド表示)。
# shim が自分自身を再解決しないよう、先に実体を確定してから PATH へ追加する。
# shellcheck source=_lib/assume.sh
source "${_bin}/_lib/assume.sh"
if _real="$(tc_real_tccli)"; then
  export CLOUD_CLI_REAL_TCCLI="$_real"
  export PATH="${_bin}/_shims:${PATH}"
fi

COMMAND="$COMMANDS/$CMD"

if [[ ! -x "$COMMAND" ]]; then
  echo "unknown command: $CMD"
  exit 1
fi

# tc-assume にプロファイルがある場合は必ず assume（TC_ASSUME_WRAPPED で再帰防止）。
if tc_should_assume; then
  if [[ $# -eq 0 ]]; then
    tc_assume_exec "$COMMAND" help
  else
    tc_assume_exec "$COMMAND" "$@"
  fi
fi

# 引数なしなら help
if [[ $# -eq 0 ]]; then
  exec "$COMMAND" help
else
  exec "$COMMAND" "$@"
fi
