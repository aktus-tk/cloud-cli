#!/usr/bin/env bash

if [[ -L "$0" ]]; then
  _bin="$(dirname "$(readlink -f "$0")")"
else
  _bin="$(dirname "$0")"
fi

_debug=0
_region=""
_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --debug)
      _debug=1
      shift
      ;;
    --region)
      [[ -n "${2:-}" ]] || { echo "tcclit: --region requires a value" >&2; exit 1; }
      _region="$2"
      shift 2
      ;;
    --region=*)
      _region="${1#--region=}"
      [[ -n "$_region" ]] || { echo "tcclit: --region requires a value" >&2; exit 1; }
      shift
      ;;
    *)
      _args+=("$1")
      shift
      ;;
  esac
done
set -- "${_args[@]}"

if [[ -n "$_region" ]]; then
  export CLOUD_CLI_TCCLI_REGION="$_region"
fi

COMMANDS="${_bin}/../commands"
CMD="$1"

if [[ -z "$CMD" ]]; then
  echo "usage: tcclit [--debug] [--region <name>] <command> ..."
  echo
  echo "global options:"
  echo "  --debug              print resolved tccli invocations"
  echo "  --region <name>      set Tencent Cloud region for this invocation (anywhere in args)"
  echo
  echo "available commands:"
  ls "$COMMANDS"
  exit 1
fi

shift

if [[ "$_debug" -eq 1 ]]; then
  export CLOUD_CLI_DEBUG=1
fi

# tccli を常に shim 経由にする (--profile 自動注入 / --debug 時のコマンド表示)。
# shim が自分自身を再解決しないよう、先に実体を確定してから PATH へ追加する。
# shellcheck source=_lib/assume.sh
source "${_bin}/_lib/assume.sh"
if _real="$(tc_real_tccli)"; then
  export CLOUD_CLI_REAL_TCCLI="$_real"
  export PATH="${_bin}/_shims:${PATH}"
fi

COMMAND="$COMMANDS/$CMD"

if [[ ! -x "$COMMAND" ]]; then
  echo "unknown command: $CMD"
  exit 1
fi

# tc-assume にプロファイルがある場合は必ず assume（TC_ASSUME_WRAPPED で再帰防止）。
# login / open は tc-assume を直接呼ぶため exec ラッパーは使わない。
if [[ "$CMD" != "login" && "$CMD" != "open" ]] && tc_should_assume; then
  if [[ $# -eq 0 ]]; then
    tc_assume_exec "$COMMAND" help
  else
    tc_assume_exec "$COMMAND" "$@"
  fi
fi

# 引数なしなら help（login はそのまま実行）
if [[ $# -eq 0 ]]; then
  if [[ "$CMD" == "login" ]]; then
    exec "$COMMAND"
  else
    exec "$COMMAND" help
  fi
else
  exec "$COMMAND" "$@"
fi
