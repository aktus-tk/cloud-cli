#!/usr/bin/env bash
set -e

cmd=$1
shift || true

cvm_get_id () {
  local name=$1
  local filters id
  filters=$(jq -cn --arg n "$name" '[{Name: "instance-name", Values: [$n]}]')
  id=$(tccli cvm DescribeInstances --Filters "$filters" --output json \
    | jq -r '.InstanceSet[0].InstanceId // empty')
  if [[ -n "$id" ]]; then
    echo "$id"
    return 0
  fi
  tccli cvm DescribeInstances --output json | jq -r --arg n "$name" '
    .InstanceSet[]?
    | select([.Tags[]? | select(.Key == "Name" and .Value == $n)] | length > 0)
    | .InstanceId' | head -1
}

