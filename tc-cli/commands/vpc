#!/usr/bin/env bash
set -euo pipefail

cmd=${1:-}
shift || true

# global mutation flags (--dry-run / --yes): strip from args, export for helpers
VPC_DRY_RUN=0
VPC_YES=0
_args=()
for _a in "$@"; do
  case "$_a" in
    --dry-run) VPC_DRY_RUN=1 ;;
    --yes) VPC_YES=1 ;;
    *) _args+=("$_a") ;;
  esac
done
set -- "${_args[@]+"${_args[@]}"}"
export VPC_DRY_RUN VPC_YES

usage() {
  cat <<EOF
usage: tcclit vpc sg ls [--detail] [--cidr CIDR] [--ingress-only]
       tcclit vpc sg show <sg-id|name>
       tcclit vpc sg rule add <sg-id|name> --proto tcp --port 22 (--addr-template NAME | --cidr IP) [--action ACCEPT|DROP] [--desc S] [--direction ingress] [--dry-run] [--yes]
       tcclit vpc sg rule rm  <sg-id|name> --proto tcp --port 22 (--addr-template NAME | --cidr IP) [--action ACCEPT|DROP] [--direction ingress] [--dry-run] [--yes]
       tcclit vpc addr ls
       tcclit vpc addr show NAME
       tcclit vpc addr create NAME --ips IP[,IP...] [--desc S] [--dry-run] [--yes]
       tcclit vpc addr set NAME --ips IP[,IP...] [--desc S] [--dry-run] [--yes]
       tcclit vpc addr add NAME IP[,IP...] [--desc S] [--dry-run] [--yes]
       tcclit vpc addr remove NAME IP[,IP...] [--dry-run] [--yes]

更新系サブコマンド (create/set/add/remove, sg rule add/rm) は:
  --dry-run   送る tccli コマンドと JSON ペイロードを表示して終了（API 呼び出しなし）
  --yes       確認プロンプトを省略して実行
  add/remove は冪等（既にあれば / 既に無ければ何もしない）。

管理用 SSH の想定運用（アドレステンプレート admin-ssh を SG ルールから参照）:
  既存の SG ルールは変更・削除しない。tcclit vpc sg rule add で
  admin-ssh テンプレートを参照する新ルールを 1 つ「追加するだけ」。
  IP 変更時はアドレステンプレートの中身だけを更新する:
  1. tcclit vpc addr add admin-ssh NEW_IP --dry-run   # 確認後 --yes で実行
  2. NEW_IP から SSH できることを確認
  3. tcclit vpc addr remove admin-ssh OLD_IP --dry-run # 確認後 --yes で実行

ls はセキュリティグループ一覧（sg-id, sg-name）を表示する。
--detail を付けると SG ごとにブロック表示する（awst sg ls --detail と同じレイアウト）:
メタデータ行 (Region/GroupName/GroupId/VpcId/Description/Tags) の後に
Inbound / Outbound のルール表 (Dir, Proto, Ports, Action, Source|Destination) が続く。
show は 1 つの SG のインバウンド / アウトバウンドルールを表示する（人が読む表形式）。

options (ls --detail):
  --cidr CIDR       CidrBlock が指定 IP またはプレフィックスを含むルールだけを表示 (例: 18.180.232.11)
  --ingress-only    egress ルールを省略 (default: ingress + egress)

examples:
  tcclit vpc sg ls
  tcclit vpc sg ls --detail
  tcclit vpc sg ls --detail --cidr 18.180.232.11 --ingress-only
  tcclit vpc sg show sg-abcdefgh
  tcclit vpc sg show my-app-sg
EOF
}

sg_resolve_id() {
  local key="${1:-}"
  if [[ -z "$key" ]]; then
    echo "missing security group id or name" >&2
    return 1
  fi
  if [[ "$key" =~ ^sg- ]]; then
    echo "$key"
    return 0
  fi
  local id
  id="$(tccli vpc DescribeSecurityGroups \
    --Filters "[{\"Name\":\"security-group-name\",\"Values\":[\"$key\"]}]" \
    --output json | jq -r '.SecurityGroupSet[0].SecurityGroupId // empty')"
  if [[ -n "$id" ]]; then
    echo "$id"
    return 0
  fi
  echo "Security group not found: $key" >&2
  return 1
}

sg_show_one_policy_line() {
  local direction="$1"
  jq -r --arg d "$direction" '
    . as $rule |
    ($rule.Protocol // "ALL") as $proto |
    ($rule.Port // "all") as $port |
    ($rule.Action // "-") as $action |
    (
      if (($rule.CidrBlock // "") != "") then "CIDR=\($rule.CidrBlock)"
      elif (($rule.Ipv6CidrBlock // "") != "") then "CIDR6=\($rule.Ipv6CidrBlock)"
      elif (($rule.SecurityGroupId // "") != "") then "SG=\($rule.SecurityGroupId)"
      elif (($rule.AddressTemplate.AddressId // "") != "") then "ADDR=\($rule.AddressTemplate.AddressId)"
      elif (($rule.AddressTemplate.AddressGroupId // "") != "") then "ADDRGRP=\($rule.AddressTemplate.AddressGroupId)"
      elif (($rule.ServiceTemplate.ServiceId // "") != "") then "SVC=\($rule.ServiceTemplate.ServiceId)"
      elif (($rule.ServiceTemplate.ServiceGroupId // "") != "") then "SVCGRP=\($rule.ServiceTemplate.ServiceGroupId)"
      else "(none listed)"
      end
    ) as $target |
    ($rule.PolicyDescription // "") as $desc |
    if $desc != "" then
      "\($d)\t\($proto)\t\($port)\t\($action)\t\($target)\t\($desc)"
    else
      "\($d)\t\($proto)\t\($port)\t\($action)\t\($target)"
    end
  '
}

_cidr_matches() {
  local block="${1:-}"
  local needle="${2:-}"
  [[ -n "$block" && -n "$needle" ]] || return 1
  if [[ "$block" == *"$needle"* ]]; then
    return 0
  fi
  local ip="${needle%%/*}"
  [[ "$block" == "${ip}/32" || "$block" == "$ip" ]] && return 0
  return 1
}

sg_ls_brief() {
  echo "sg-id,sg-name"
  tccli vpc DescribeSecurityGroups --output json \
    | jq -r '.SecurityGroupSet[]? | [.SecurityGroupId, .SecurityGroupName] | @csv'
}

sg_effective_region() {
  local region="${CLOUD_CLI_TCCLI_REGION:-${TENCENTCLOUD_REGION:-}}"
  if [[ -z "$region" ]]; then
    local profile="${TCCLI_PROFILE:-${TENCENTCLOUD_PROFILE:-default}}"
    local conf_file="${HOME}/.tccli/${profile}.configure"
    if [[ -f "$conf_file" ]]; then
      region="$(jq -r '._sys_param.region // empty' "$conf_file" 2>/dev/null || true)"
    fi
  fi
  printf '%s' "$region"
}

# One rule row: Dir, Proto, Ports, Action, Target (with description appended).
sg_ls_detail_rule_line() {
  local direction="$1"
  jq -r --arg d "$direction" '
    def with_desc($desc): if (($desc // "") == "") then "" else " (\($desc))" end;
    . as $rule |
    ($rule.Protocol // "ALL") as $proto |
    ($rule.Port // "all") as $port |
    ($rule.Action // "-") as $action |
    (
      if (($rule.CidrBlock // "") != "") then "CIDR=\($rule.CidrBlock)"
      elif (($rule.Ipv6CidrBlock // "") != "") then "CIDR6=\($rule.Ipv6CidrBlock)"
      elif (($rule.SecurityGroupId // "") != "") then "SG=\($rule.SecurityGroupId)"
      elif (($rule.AddressTemplate.AddressId // "") != "") then "ADDR=\($rule.AddressTemplate.AddressId)"
      elif (($rule.AddressTemplate.AddressGroupId // "") != "") then "ADDRGRP=\($rule.AddressTemplate.AddressGroupId)"
      elif (($rule.ServiceTemplate.ServiceId // "") != "") then "SVC=\($rule.ServiceTemplate.ServiceId)"
      elif (($rule.ServiceTemplate.ServiceGroupId // "") != "") then "SVCGRP=\($rule.ServiceTemplate.ServiceGroupId)"
      else "(none listed)"
      end
    ) as $target |
    "\($d)\t\($proto)\t\($port)\t\($action)\t\($target)\(with_desc($rule.PolicyDescription))"
  '
}

# Emit rule rows for one direction, honoring the optional --cidr filter.
sg_ls_detail_rule_lines() {
  local policy_json="$1" dir_key="$2" dir_label="$3" cidr_filter="$4"
  echo "$policy_json" | jq -c ".SecurityGroupPolicySet.${dir_key}[]?" 2>/dev/null | while read -r row; do
    [[ -z "$row" ]] && continue
    if [[ -n "$cidr_filter" ]]; then
      _cidr_matches "$(echo "$row" | jq -r '.CidrBlock // ""')" "$cidr_filter" || continue
    fi
    echo "$row" | sg_ls_detail_rule_line "$dir_label"
  done
}

sg_ls_detail() {
  local cidr_filter=""
  local ingress_only=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cidr)
        cidr_filter="${2:-}"
        shift 2
        ;;
      --cidr=*)
        cidr_filter="${1#--cidr=}"
        shift
        ;;
      --ingress-only)
        ingress_only=true
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        echo "unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  local region sg_data
  region="$(sg_effective_region)"
  sg_data="$(tccli vpc DescribeSecurityGroups --output json)"

  local gid
  while IFS= read -r gid; do
    [[ -z "$gid" ]] && continue

    local meta name vpcid desc tags
    meta="$(echo "$sg_data" | jq -c --arg id "$gid" '.SecurityGroupSet[] | select(.SecurityGroupId == $id)')"
    name="$(echo "$meta" | jq -r '.SecurityGroupName // ""')"
    vpcid="$(echo "$meta" | jq -r '.VpcId // ""')"
    desc="$(echo "$meta" | jq -r '.SecurityGroupDesc // ""')"
    tags="$(echo "$meta" | jq -r '((.TagSet // []) | map("\(.Key)=\(.Value)") | join(","))')"

    local policy_json in_lines out_lines
    policy_json="$(tccli vpc DescribeSecurityGroupPolicies --SecurityGroupId "$gid" --output json)"
    in_lines="$(sg_ls_detail_rule_lines "$policy_json" "Ingress" "IN" "$cidr_filter")"
    out_lines=""
    if [[ "$ingress_only" == false ]]; then
      out_lines="$(sg_ls_detail_rule_lines "$policy_json" "Egress" "OUT" "$cidr_filter")"
    fi

    # --cidr 指定時は一致ルールが無い SG を出力しない
    if [[ -n "$cidr_filter" && -z "$in_lines" && -z "$out_lines" ]]; then
      continue
    fi

    echo "---"
    echo -e "Region\tGroupName\tGroupId\tVpcId\tDescription\tTags"
    echo -e "$region\t$name\t$gid\t$vpcid\t$desc\t$tags" | column -t -s $'\t'
    echo ""

    if [[ -n "$in_lines" ]]; then
      echo "  Inbound:"
      echo -e "  Dir\tProto\tPorts\tAction\tSource"
      printf '%s\n' "$in_lines" | column -t -s $'\t'
    fi
    if [[ -n "$out_lines" ]]; then
      echo "  Outbound:"
      echo -e "  Dir\tProto\tPorts\tAction\tDestination"
      printf '%s\n' "$out_lines" | column -t -s $'\t'
    fi
    echo ""
  done < <(echo "$sg_data" | jq -r '.SecurityGroupSet[]?.SecurityGroupId')
}

sg_ls() {
  local detail=false
  local cidr_filter=""
  local ingress_only=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --detail)
        detail=true
        shift
        ;;
      --cidr)
        cidr_filter="${2:-}"
        shift 2
        ;;
      --cidr=*)
        cidr_filter="${1#--cidr=}"
        shift
        ;;
      --ingress-only)
        ingress_only=true
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        echo "unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  if [[ "$detail" == true ]]; then
    local detail_args=()
    [[ -n "$cidr_filter" ]] && detail_args+=(--cidr "$cidr_filter")
    [[ "$ingress_only" == true ]] && detail_args+=(--ingress-only)
    sg_ls_detail "${detail_args[@]}"
    return
  fi

  if [[ -n "$cidr_filter" || "$ingress_only" == true ]]; then
    echo "options --cidr and --ingress-only require ls --detail" >&2
    usage >&2
    exit 1
  fi

  sg_ls_brief
}

sg_show() {
  local key="${1:-}"
  if [[ -z "$key" ]]; then
    echo "Usage: tcclit vpc sg show <sg-id|name>" >&2
    exit 1
  fi

  local gid
  gid="$(sg_resolve_id "$key")"

  local sg_json policy_json
  sg_json="$(tccli vpc DescribeSecurityGroups \
    --SecurityGroupIds "[\"$gid\"]" \
    --output json)"
  policy_json="$(tccli vpc DescribeSecurityGroupPolicies \
    --SecurityGroupId "$gid" \
    --output json)"

  echo "$sg_json" | jq -r '.SecurityGroupSet[0] |
    "SecurityGroupId: \(.SecurityGroupId)",
    "SecurityGroupName: \(.SecurityGroupName)",
    "VpcId: \(.VpcId // "-")",
    "Description: \(.SecurityGroupDesc // "-")",
    "IsDefault: \(.IsDefault)",
    ""'

  echo "=== Inbound ==="
  echo -e "Dir\tProto\tPort\tAction\tTarget\tDescription"
  echo "$policy_json" | jq -c '.SecurityGroupPolicySet.Ingress[]?' 2>/dev/null | while read -r row; do
    [[ -z "$row" ]] && continue
    echo "$row" | sg_show_one_policy_line "IN"
  done | column -t -s $'\t' || true

  echo ""
  echo "=== Outbound ==="
  echo -e "Dir\tProto\tPort\tAction\tTarget\tDescription"
  echo "$policy_json" | jq -c '.SecurityGroupPolicySet.Egress[]?' 2>/dev/null | while read -r row; do
    [[ -z "$row" ]] && continue
    echo "$row" | sg_show_one_policy_line "OUT"
  done | column -t -s $'\t' || true
}

# ---- shared: dry-run / confirm -------------------------------------------

vpc_confirm_or_abort() {
  # $1 = question. Returns 0 = proceed, 1 = abort.
  if [[ "${VPC_DRY_RUN:-0}" == 1 ]]; then
    echo "dry-run: no API call made"
    return 1
  fi
  if [[ "${VPC_YES:-0}" == 1 ]]; then
    return 0
  fi
  read -r -p "$1 [y/N]: " ans
  [[ "$ans" == "y" || "$ans" == "yes" ]]
}

# run_tccli CMD... — prints the invocation, then dry-run aborts or executes.
vpc_run_tccli() {
  echo "+ tccli $*" >&2
  if [[ "${VPC_DRY_RUN:-0}" == 1 ]]; then
    echo "dry-run: no API call made"
    return 1
  fi
  tccli "$@"
}

addr_resolve_id() {
  local name="${1:-}"
  [[ -n "$name" ]] || { echo "missing address template name" >&2; return 1; }
  if [[ "$name" =~ ^ipm- ]]; then
    echo "$name"
    return 0
  fi
  tccli vpc DescribeAddressTemplates \
    --Filters "[{\"Name\":\"address-template-name\",\"Values\":[\"$name\"]}]" \
    --output json | jq -r '.AddressTemplateSet[0].AddressTemplateId // empty'
}

addr_list_ips() {
  # $1 = template id; prints comma-joined IPs (empty if none)
  tccli vpc DescribeAddressTemplates \
    --Filters "[{\"Name\":\"address-template-id\",\"Values\":[\"$1\"]}]" --output json \
    | jq -r '.AddressTemplateSet[0].AddressSet // [] | join(",")'
}

addr_ls() {
  echo "addr-template-id,addr-template-name,ips"
  tccli vpc DescribeAddressTemplates --output json \
    | jq -r '.AddressTemplateSet[]? | [.AddressTemplateId, .AddressTemplateName, ((.AddressSet // []) | join(","))] | @csv'
}

addr_show() {
  local key="${1:-}"
  [[ -n "$key" ]] || { echo "Usage: tcclit vpc addr show NAME" >&2; exit 1; }
  local id
  id="$(addr_resolve_id "$key")" || exit 1
  [[ -n "$id" ]] || { echo "Address template not found: $key" >&2; exit 1; }
  tccli vpc DescribeAddressTemplates \
    --Filters "[{\"Name\":\"address-template-id\",\"Values\":[\"$id\"]}]" --output json \
    | jq -r '.AddressTemplateSet[0] | "AddressTemplateId: \(.AddressTemplateId)", "AddressTemplateName: \(.AddressTemplateName)", "CreatedTime: \(.CreatedTime // "-")", "IPs:", ((.AddressSet // [])[] | "  \(.)")'
}

addr_create() {
  local name="${1:-}"; shift || true
  local ips="" desc="tk home-note"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ips) ips="${2:-}"; shift 2 ;;
      --ips=*) ips="${1#--ips=}"; shift ;;
      --desc) desc="${2:-}"; shift 2 ;;
      --desc=*) desc="${1#--desc=}"; shift ;;
      *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
  done
  [[ -n "$name" && -n "$ips" ]] || { echo "Usage: tcclit vpc addr create NAME --ips IP[,IP...] [--desc S]" >&2; exit 1; }
  # 冪等: 既存なら何もしない
  local existing
  existing="$(addr_resolve_id "$name" 2>/dev/null || true)"
  if [[ -n "$existing" ]]; then
    echo "address template $name already exists ($existing); nothing to do"
    return 0
  fi
  local extra_json
  extra_json="$(printf '%s' "$ips" | jq -R 'split(",") | map({Address: ., Description: $d})' --arg d "$desc")"
  echo "create address template: $name ips=$ips desc=$desc"
  vpc_run_tccli vpc CreateAddressTemplate --AddressTemplateName "$name" --AddressesExtra "$extra_json" \
    && echo "created: $name"
}

addr_set() {
  local name="${1:-}"; shift || true
  local ips="" desc="tk home-note"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ips) ips="${2:-}"; shift 2 ;;
      --ips=*) ips="${1#--ips=}"; shift ;;
      --desc) desc="${2:-}"; shift 2 ;;
      --desc=*) desc="${1#--desc=}"; shift ;;
      *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
  done
  [[ -n "$name" && -n "$ips" ]] || { echo "Usage: tcclit vpc addr set NAME --ips IP[,IP...] [--desc S]" >&2; exit 1; }
  local id
  id="$(addr_resolve_id "$name")" || exit 1
  [[ -n "$id" ]] || { echo "Address template not found: $name" >&2; exit 1; }
  local before extra_json
  before="$(addr_list_ips "$id")"
  extra_json="$(printf '%s' "$ips" | jq -R 'split(",") | map({Address: ., Description: $d})' --arg d "$desc")"
  echo "set address template: $name ($id)"
  echo "  before: ${before:-(none)}"
  echo "  after:  $ips"
  vpc_confirm_or_abort "apply?" || return 0
  vpc_run_tccli vpc ModifyAddressTemplateAttribute --AddressTemplateId "$id" --AddressesExtra "$extra_json" \
    && echo "updated: $name"
}

addr_add_remove() {
  local mode="$1" name="$2"; shift 2
  local ips="${1:-}" desc="tk home-note"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --desc) desc="${2:-}"; shift 2 ;;
      --desc=*) desc="${1#--desc=}"; shift ;;
      *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
  done
  [[ -n "$name" && -n "$ips" ]] || { echo "Usage: tcclit vpc addr $mode NAME IP[,IP...] [--desc S]" >&2; exit 1; }
  local id
  id="$(addr_resolve_id "$name")" || exit 1
  [[ -n "$id" ]] || { echo "Address template not found: $name" >&2; exit 1; }
  IFS=',' read -ra wanted <<< "$ips"
  local current
  current="$(addr_list_ips "$id")"
  local cur_arr=() ; [[ -n "$current" ]] && IFS=',' read -ra cur_arr <<< "$current"
  _addr_has() { local v; for v in ${cur_arr[@]+"${cur_arr[@]}"}; do [[ "$v" == "$1" ]] && return 0; done; return 1; }

  local targets=() changed=0 skipped=0 v
  if [[ "$mode" == "add" ]]; then
    for v in "${wanted[@]}"; do
      if _addr_has "$v"; then skipped=$((skipped+1)); else targets+=("$v"); changed=1; fi
    done
  else
    for v in "${wanted[@]}"; do
      if _addr_has "$v"; then targets+=("$v"); changed=1; else skipped=$((skipped+1)); fi
    done
  fi
  if [[ "$changed" == 0 ]]; then
    echo "no change needed ($skipped entr(y|ies) already $( [[ $mode == add ]] && echo present || echo absent ))"
    return 0
  fi
  echo "address template: $name ($id) [$mode]"
  echo "  before: ${current:-(none)}"
  echo "  $mode:  $(printf '%s,' "${targets[@]}" | sed 's/,$//')"
  vpc_confirm_or_abort "apply?" || return 0
  if [[ "$mode" == "add" ]]; then
    local member_json
    member_json="$(printf '%s\n' "${targets[@]}" | jq -R '{Member: ., Description: $d}' --arg d "$desc" | jq -s .)"
    vpc_run_tccli vpc AddTemplateMember --TemplateId "$id" --TemplateMember "$member_json" \
      && echo "added member(s)"
  else
    local member_json
    member_json="$(printf '%s\n' "${targets[@]}" | jq -R '{Member: .}' | jq -s .)"
    vpc_run_tccli vpc DeleteTemplateMember --TemplateId "$id" --TemplateMember "$member_json" \
      && echo "removed member(s)"
  fi
}

sg_rule_add() {
  local sg_key="${1:-}"; shift || true
  local proto="" port="" tmpl="" cidr="" desc="" direction="ingress" action="ACCEPT"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --proto) proto="$2"; shift 2 ;;
      --port) port="$2"; shift 2 ;;
      --addr-template) tmpl="$2"; shift 2 ;;
      --cidr) cidr="$2"; shift 2 ;;
      --desc) desc="$2"; shift 2 ;;
      --action) action="${2^^}"; shift 2 ;;
      --direction) direction="$2"; shift 2 ;;
      *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
  done
  [[ -n "$sg_key" && -n "$proto" && -n "$port" ]] || { echo "Usage: tcclit vpc sg rule add SG --proto tcp --port 22 (--addr-template NAME | --cidr IP) [--action ACCEPT|DROP] [--desc S]" >&2; exit 1; }
  [[ "$action" == "ACCEPT" || "$action" == "DROP" ]] || { echo "--action must be ACCEPT or DROP" >&2; exit 1; }
  if [[ -z "$cidr" ]]; then
    [[ -n "$tmpl" ]] || { echo "--addr-template or --cidr is required" >&2; exit 1; }
    cidr="$(addr_resolve_id "$tmpl")" || exit 1
    [[ -n "$cidr" ]] || { echo "Address template not found: $tmpl" >&2; exit 1; }
  fi
  local gid
  gid="$(sg_resolve_id "$sg_key")" || exit 1
  local dir_key dir_label
  if [[ "$direction" == egress* ]]; then dir_key="Egress"; dir_label="egress"; else dir_key="Ingress"; dir_label="ingress"; fi
  # 冪等: 同一 proto/port/target のルールが既にあれば何もしない
  local dup
  dup="$(tccli vpc DescribeSecurityGroupPolicies --SecurityGroupId "$gid" --output json \
    | jq -c --arg proto "$proto" --arg port "$port" --arg target "$cidr" --arg action "$action" \
      ".SecurityGroupPolicySet.${dir_key}[]? | select((.Protocol // \"ALL\") == \$proto and (.Port // \"all\") == \$port and ((.CidrBlock // .AddressTemplate.AddressGroupId // .AddressTemplate.AddressId // \"\") == \$target))")"
  if [[ -n "$dup" ]]; then
    echo "rule already exists; nothing to do"
    return 0
  fi
  local policy
  policy="$(jq -n --arg proto "$proto" --arg port "$port" --arg target "$cidr" --arg desc "$desc" --arg action "$action" \
    '{($dir): [ {Protocol: $proto, Port: $port, Action: $action,
        (if ($target|test("^ipm-")) then "AddressTemplate" else "CidrBlock" end):
          (if ($target|test("^ipm-")) then {AddressId: $target} else $target end)
      } + (if ($desc != "") then {PolicyDescription: $desc} else {} end) ] }' \
    --arg dir "$dir_key")"
  echo "sg rule add: $gid ($dir_label) $proto:$port target=$cidr action=$action${desc:+ desc=$desc}"
  vpc_confirm_or_abort "apply?" || return 0
  vpc_run_tccli vpc CreateSecurityGroupPolicies --SecurityGroupId "$gid" --SecurityGroupPolicySet "$policy" \
    && echo "created rule"
}

sg_rule_rm() {
  local sg_key="${1:-}"; shift || true
  local proto="" port="" tmpl="" cidr="" direction="ingress" action=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --proto) proto="$2"; shift 2 ;;
      --port) port="$2"; shift 2 ;;
      --addr-template) tmpl="$2"; shift 2 ;;
      --cidr) cidr="$2"; shift 2 ;;
      --action) action="${2^^}"; shift 2 ;;
      --direction) direction="$2"; shift 2 ;;
      *) echo "unknown option: $1" >&2; exit 1 ;;
    esac
  done
  [[ -n "$sg_key" && -n "$proto" && -n "$port" ]] || { echo "Usage: tcclit vpc sg rule rm SG --proto tcp --port 22 (--addr-template NAME | --cidr IP) [--action ACCEPT|DROP]" >&2; exit 1; }
  if [[ -z "$cidr" ]]; then
    [[ -n "$tmpl" ]] || { echo "--addr-template or --cidr is required" >&2; exit 1; }
    cidr="$(addr_resolve_id "$tmpl")" || exit 1
    [[ -n "$cidr" ]] || { echo "Address template not found: $tmpl" >&2; exit 1; }
  fi
  local gid
  gid="$(sg_resolve_id "$sg_key")" || exit 1
  local dir_key
  if [[ "$direction" == egress* ]]; then dir_key="Egress"; else dir_key="Ingress"; fi
  local matches
  matches="$(tccli vpc DescribeSecurityGroupPolicies --SecurityGroupId "$gid" --output json \
    | jq -c --arg proto "$proto" --arg port "$port" --arg target "$cidr" --arg action "$action" \
      ".SecurityGroupPolicySet.${dir_key}[]?
       | select((.Protocol // \"ALL\") == \$proto and (.Port // \"all\") == \$port
                and ((.CidrBlock // .AddressTemplate.AddressGroupId // .AddressTemplate.AddressId // \"\") == \$target)
                and (\$action == \"\" or (.Action // \"ACCEPT\") == \$action))")"
  if [[ -z "$matches" ]]; then
    echo "no matching rule; nothing to do"
    return 0
  fi
  while IFS= read -r rule; do
    [[ -z "$rule" ]] && continue
    local idx
    idx="$(echo "$rule" | jq -r '.PolicyIndex')"
    echo "sg rule rm: $gid ($dir_key index=$idx) $proto:$port target=$cidr action=$(echo "$rule" | jq -r '.Action // "ACCEPT"')"
    vpc_confirm_or_abort "apply?" || continue
    local policy
    policy="$(jq -n --arg dir "$dir_key" --arg idx "$idx" '{($dir): [{PolicyIndex: ($idx|tonumber)}]}')"
    vpc_run_tccli vpc DeleteSecurityGroupPolicies --SecurityGroupId "$gid" --SecurityGroupPolicySet "$policy" \
      && echo "deleted rule (index=$idx)"
  done <<< "$matches"
}

case "$cmd" in
  sg)
    case "${1:-}" in
      rule)
        sub="${2:-}"
        if [[ -z "$sub" ]]; then
          echo "Usage: tcclit vpc sg rule add|rm SG --proto tcp --port 22 (--addr-template NAME | --cidr IP)" >&2
          exit 1
        fi
        shift 2 || true
        case "$sub" in
          add) sg_rule_add "$@" ;;
          rm|remove|delete) sg_rule_rm "$@" ;;
          *) echo "Usage: tcclit vpc sg rule add|rm SG --proto tcp --port 22 (--addr-template NAME | --cidr IP)" >&2; exit 1 ;;
        esac
        ;;
      show)
        shift
        sg_show "$@"
        ;;
      ls|list)
        shift || true
        sg_ls "$@"
        ;;
      help|-h|--help|"")
        usage
        ;;
      *)
        echo "unknown: ${1:-}" >&2
        usage >&2
        exit 1
        ;;
    esac
    ;;
  addr)
    case "${1:-}" in
      ls|list)
        shift || true
        addr_ls
        ;;
      show)
        shift
        addr_show "$@"
        ;;
      create)
        subname="${2:-}"; shift 2 || true
        addr_create "$subname" "$@"
        ;;
      set)
        subname="${2:-}"; shift 2 || true
        addr_set "$subname" "$@"
        ;;
      add)
        subname="${2:-}"; shift 2 || true
        addr_add_remove add "$subname" "$@"
        ;;
      rm|remove)
        subname="${2:-}"; shift 2 || true
        addr_add_remove remove "$subname" "$@"
        ;;
      help|-h|--help|"")
        usage
        ;;
      *)
        echo "unknown: ${1:-}" >&2
        usage >&2
        exit 1
        ;;
    esac
    ;;
  help|-h|--help|"")
    echo
    echo "Examples:"
    echo "  tcclit vpc sg ls"
    echo "  tcclit vpc sg ls --detail --cidr 18.180.232.11 --ingress-only"
    echo "  tcclit vpc sg show my-app-sg"
    ;;
  *)
    echo "unknown: $cmd" >&2
    echo "run: tcclit vpc help" >&2
    exit 1
    ;;
esac
