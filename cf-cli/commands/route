#!/usr/bin/env bash
set -e

source "$(dirname "$(readlink -f "$0")")/_lib/cf.sh"

cmd=$1
shift || true

# tunnel routes (WARP / cloudflared private network routes)
# cf network routes cidr list
route_ls() {
  cf_debug_exit network routes cidr list
  echo -e "Network\tTunnelID\tComment\tID"
  "$CF_BIN" network routes cidr list | jq -r '
    .result[]?
    | [
        (.network // ""),
        (.tunnel_id // ""),
        (.comment // ""),
        (.id // "")
      ]
    | @tsv
  ' | sort | cf_table
}

usage() {
  cat <<EOF
usage: cft route <command>

Tunnel routes（プライベートネットワーク経路）の調査（読み取り専用）

commands:
  list              tunnel route 一覧 (cf network routes cidr list)
  --json            cf の JSON をそのまま出力
  raw ARGS...       公式 cf CLI にそのまま委譲

examples:
  cft route list
  cft route list --json
EOF
}

case "$cmd" in
  ls|list)
    if [[ "${1:-}" == "--json" ]]; then
      cf_json network routes cidr list
    else
      route_ls
    fi
    ;;
  raw)
    exec "$CF_BIN" "$@"
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    echo "unknown route command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
