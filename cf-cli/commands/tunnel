#!/usr/bin/env bash
set -e

source "$(dirname "$(readlink -f "$0")")/_lib/cf.sh"

cmd=$1
shift || true

tunnel_ls() {
  cf_debug_exit tunnels list
  echo -e "Name\tID\tStatus\tType\tConnections\tCreatedAt"
  cf_list_json tunnels list | jq -r '
    .[]
    | [
        .name,
        .id,
        (.status // ""),
        (.tun_type // ""),
        ((.connections // []) | length | tostring),
        (.created_at // "")
      ]
    | @tsv
  ' | sort | cf_table
}

tunnel_show() {
  cf_debug_exit "tunnels get <resolved-tunnel-id>"
  local id
  id="$(tunnel_get_id "$1")"
  cf_json tunnels get "$id" | jq -r '
    (.result // .)
    | "ID:        \(.id)",
      "Name:      \(.name)",
      "Status:    \(.status // "-")",
      "Type:      \(.tun_type // "-")",
      "CreatedAt: \(.created_at // "-")",
      "Conns:     \((.connections // []) | length)",
      "",
      (["ConnID", "Colo", "ClientVersion"] | @tsv),
      ((.connections // [])[]
        | [(.id // ""), (.colo_name // ""), (.client_version // "")] | @tsv)
  ' | cf_table
}

tunnel_status() {
  cf_debug_exit "tunnels get <resolved-tunnel-id>"
  local id
  id="$(tunnel_get_id "$1")"
  cf_json tunnels get "$id" | jq -r '
    (.result // .)
    | "Tunnel:    \(.name) (\(.id))",
      "Status:    \(.status // "-")",
      "Connections: \((.connections // []) | length)",
      ((.connections // [])[]
        | "  colo=\(.colo_name // "-") ver=\(.client_version // "-")")
  '
}

usage() {
  cat <<EOF
usage: cft tunnel <command>

Cloudflare Tunnel の調査（読み取り専用）

commands:
  list              トンネル一覧 (cf tunnels list)
  show NAME|ID      トンネル詳細＋コネクション (cf tunnels get)
  status NAME|ID    トンネルの稼働状態 (cf tunnels get)
  --json            各コマンドに付けて cf の JSON をそのまま出力
  raw ARGS...       公式 cf CLI にそのまま委譲

examples:
  cft tunnel list
  cft tunnel show prod-tunnel
  cft tunnel status prod-tunnel --json
EOF
}

case "$cmd" in
  ls|list)
    if [[ "${1:-}" == "--json" ]]; then
      cf_json tunnels list
    else
      tunnel_ls
    fi
    ;;
  show|get)
    if [[ "${2:-}" == "--json" ]]; then
      id="$(tunnel_get_id "$1")"
      cf_json tunnels get "$id"
    else
      [[ -n "${1:-}" ]] || { usage >&2; exit 1; }
      tunnel_show "$1"
    fi
    ;;
  status)
    if [[ "${2:-}" == "--json" ]]; then
      id="$(tunnel_get_id "$1")"
      cf_json tunnels get "$id"
    else
      [[ -n "${1:-}" ]] || { usage >&2; exit 1; }
      tunnel_status "$1"
    fi
    ;;
  raw)
    exec "$CF_BIN" "$@"
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    echo "unknown tunnel command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
