#!/usr/bin/env bash
set -e

source "$(dirname "$(readlink -f "$0")")/_lib/cf.sh"

cmd=$1
shift || true

# Zero Trust (Access) ユーザー一覧
# cf zero-trust access users list
user_ls() {
  cf_debug_exit zero-trust access users list
  echo -e "Name\tEmail\tStatus\tLastSeen\tID"
  "$CF_BIN" zero-trust access users list | jq -r '
    .result[]?
    | [
        (.name // ""),
        (.email // ""),
        (.status // ""),
        (.last_seen_at // ""),
        (.id // "")
      ]
    | @tsv
  ' | sort | cf_table
}

usage() {
  cat <<EOF
usage: cft user <command>

Zero Trust (Access) ユーザーの調査（読み取り専用）

commands:
  list              ユーザー一覧 (cf zero-trust access users list)
  --json            cf の JSON をそのまま出力
  raw ARGS...       公式 cf CLI にそのまま委譲

examples:
  cft user list
  cft user list --json
EOF
}

case "$cmd" in
  ls|list)
    if [[ "${1:-}" == "--json" ]]; then
      cf_json zero-trust access users list
    else
      user_ls
    fi
    ;;
  raw)
    exec "$CF_BIN" "$@"
    ;;
  help|-h|--help|"")
    usage
    ;;
  *)
    echo "unknown user command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
